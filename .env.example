#--------------------------------------------------------------------
# ORNEK ORTAM DOSYASI
# Kopyalayin: cp .env.example .env
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# VERITABANI
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = sultangazi_genclik
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

database.application.hostname = 127.0.0.1
database.application.database = sultangazi_new
database.application.username = root
database.application.password =
database.application.DBDriver = MySQLi
database.application.port = 3306

#--------------------------------------------------------------------
# NEXORA GENEL KATALOG SERVISI
# Etkinlikler ve hizmet tesisleri bu servisten okunur.
# apiKey, Nexora tarafindaki PublicApi:ApiKeys degeri ile eslesmelidir.
#--------------------------------------------------------------------

nexora.url = http://localhost:5207
nexora.apiKey =
nexora.portalUrl = https://sultansehir.sultangazi.bel.tr

#--------------------------------------------------------------------
# SULTANGAZI ANA SITE (genel mobil servis)
# Baskan icerikleri bu servisten senkron edilir.
#--------------------------------------------------------------------

sultangazi.apiUrl = https://www.sultangazi.bel.tr/api/mobile

#--------------------------------------------------------------------
# MOBIL API (/api/mobile)
# Token almak icin kullanilir. Canlida MUTLAKA degistirin.
#--------------------------------------------------------------------

mobileApi.username = sultangazi
mobileApi.password =
mobileApi.tokenExpire = 7200
