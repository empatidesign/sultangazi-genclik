{% extends BACKEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import BACKEND_TEMPLATE_PATH~'/layouts/form-elements.html.twig' as form %}

{% block body %}
<div class="row">
  <div class="col-sm-12">
    <div class="page-title-box">
      <div class="float-right">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL) }}">{{ lang('Admin.homePage') }}</a></li>
    				<li class="breadcrumb-item"><a href="javascript:void(0)">{{ lang('AdminContents.contentsTitle') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL~'/'~page_url) }}">{{ lang('AdminContents.contactInformation.title') }}</a></li>
            {% if page_name == 'add' %}
              <li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.process.addNewRecord') }}</li>
            {% endif %}

            {% if page_name == 'edit' %}
              <li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.process.editRecord') }}</li>
            {% endif %}
          </ol>
      </div>
      <h4 class="page-title">{{ lang('AdminContents.contactInformation.title') }}</h4>
    </div>
  </div>
</div>

{% if FLASH_DATA_MESSAGE_SUCCESS %}
  <div class="row">
    <div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
      <div class="alert alert-secondary mb-4 alert-dismissible fade show" role="alert">
      	<button type="button" class="close" data-dismiss="alert" aria-label="Close">
      		<span aria-hidden="true">&times;</span>
      	</button>
      	{{ FLASH_DATA_MESSAGE_SUCCESS }}
      </div>
    </div>
  </div>
{% endif %}

{% if page_name == 'index' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col-12 col-lg-6">
							<div class="main-content-label mb-0 pb-0 border-0">
								<h4 class="header-title">{{ lang('AdminContents.contactInformation.title') }}</h4>
							</div>
						</div>
						<div class="col-12 col-lg-6 text-lg-right text-left">
							<a href="{{ base_url(BACKEND_URL~'/'~page_url~'/add') }}" class="btn btn-purple">
								{{ lang('Admin.process.addNewRecord') }}
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-12">
							<div class="table-responsive">
								<table id="datatable" class="table table-bordered dt-responsive nowrap w-100" data-table-url="{{ datatable_url }}">
									<thead>
										<tr>
											<th>{{ lang('AdminContents.contactInformation.general.status') }}</th>
                      <th>{{ lang('Admin.mobile') }}</th>
											<th>{{ lang('AdminContents.contactInformation.general.default') }}</th>
											<th>{{ lang('AdminContents.contactInformation.general.name') }}</th>
											<th>{{ lang('AdminContents.contactInformation.general.telephone') }}</th>
											<th>{{ lang('AdminContents.contactInformation.general.emailAddress') }}</th>
											<th>{{ lang('AdminContents.contactInformation.general.createdDate') }}</th>
											<th>{{ lang('AdminContents.contactInformation.general.updatedDate') }}</th>
											<th class="no-sort">{{ lang('Admin.process.title') }}</th>
										</tr>
									</thead>
									<tbody></tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endif %}

{% if page_name == 'add' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/insert', 'class="custom-form" enctype="multipart/form-data"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.process.addNewRecord') }}</h4>
						</div>
						<div class="row">
							<div class="col-12 col-lg-3 mb-3">
								<label for="status">{{ lang('AdminContents.contactInformation.general.status') }} <span class="tx-danger">*</span></label>
								<select name="form[status]" id="status" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}">{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}">{{ lang('Admin.passive') }}</option>
								</select>
							</div>
              <div class="col-12 col-lg-3 mb-3">
                <label for="status_mobile">{{ lang('Admin.mobile') }} <span class="tx-danger">*</span></label>
                <select name="form[status_mobile]" id="status_mobile" class="form-control select2">
                  <option value="">{{ lang('Admin.choose') }}</option>
                  <option value="{{ FORM_ACTIVE_NUMBER }}">{{ lang('Admin.active') }}</option>
                  <option value="{{ FORM_PASSIVE_NUMBER }}">{{ lang('Admin.passive') }}</option>
                </select>
              </div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_default">{{ lang('AdminContents.contactInformation.general.default') }} <span class="tx-danger">*</span></label>
								<select name="form[contact_default]" id="contact_default" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}">{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}">{{ lang('Admin.passive') }}</option>
								</select>
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_title">{{ lang('AdminContents.contactInformation.general.name') }} <span class="tx-danger">*</span></label>
								{{ form.input('contact_title', '', '', '', '') }}
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_telephone">{{ lang('AdminContents.contactInformation.general.telephone') }}</label>
								<input type="text" name="form[contact_telephone]" id="contact_telephone" class="form-control phone" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_telephone2">{{ lang('AdminContents.contactInformation.general.telephone2') }}</label>
								<input type="text" name="form[contact_telephone2]" id="contact_telephone2" class="form-control phone" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_mobile">{{ lang('AdminContents.contactInformation.general.mobile') }}</label>
								<input type="text" name="form[contact_mobile]" id="contact_mobile" class="form-control phone" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_whatsapp">{{ lang('AdminContents.contactInformation.general.whatsapp') }}</label>
								<input type="text" name="form[contact_whatsapp]" id="contact_whatsapp" class="form-control phone" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_fax">{{ lang('AdminContents.contactInformation.general.fax') }}</label>
								<input type="text" name="form[contact_fax]" id="contact_fax" class="form-control phone" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_fax2">{{ lang('AdminContents.contactInformation.general.fax2') }}</label>
								<input type="text" name="form[contact_fax2]" id="contact_fax2" class="form-control phone" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_email">{{ lang('AdminContents.contactInformation.general.emailAddress') }}</label>
								<input type="text" name="form[contact_email]" id="contact_email" class="form-control" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_email2">{{ lang('AdminContents.contactInformation.general.emailAddress2') }}</label>
								<input type="text" name="form[contact_email2]" id="contact_email2" class="form-control" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_post_code">{{ lang('AdminContents.contactInformation.general.postCode') }}</label>
								<input type="text" name="form[contact_post_code]" id="contact_post_code" class="form-control" />
							</div>
							<div class="col-12 col-lg-12 mb-3">
								<label for="contact_map_url">{{ lang('AdminContents.contactInformation.general.mapUrl') }}</label>
								<textarea name="form[contact_map_url]" id="contact_map_url" class="form-control" rows="3"></textarea>
							</div>
							<div class="col-12 col-lg-6 mb-lg-0 mb-3">
								<label for="contact_address">{{ lang('AdminContents.contactInformation.general.address') }}</label>
								{{ form.textarea('contact_address', '', '', '', '') }}
							</div>
							<div class="col-12 col-lg-6">
								<label for="contact_working_hours">{{ lang('AdminContents.contactInformation.general.workingHours') }}</label>
								{{ form.textarea('contact_working_hours', '', '', '', '') }}
							</div>
						</div>
					</div>
				</div>

				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('AdminContents.contactInformation.general.map.title') }}</h4>
						</div>
						<div class="row">
							<div class="col-12 col-lg-6 mg-lg-b-0 mg-b-20">
								<div class="row">
									<div class="col-12 col-lg-12 mb-3">
										<label for="contact_map_lat_coordinate">{{ lang('AdminContents.contactInformation.general.map.latCoordinate') }}</label>
										<input type="text" name="form[contact_map_lat_coordinate]" id="contact_map_lat_coordinate" class="form-control" />
									</div>
									<div class="col-12 col-lg-12 mb-3">
										<label for="contact_map_long_coordinate">{{ lang('AdminContents.contactInformation.general.map.longCoordinate') }}</label>
										<input type="text" name="form[contact_map_long_coordinate]" id="contact_map_long_coordinate" class="form-control" />
									</div>
									<div class="col-12 col-lg-12">
										<label for="contact_map_zoom">{{ lang('AdminContents.contactInformation.general.map.zoom') }}</label>
										<input type="number" name="form[contact_map_zoom]" id="contact_map_zoom" class="form-control number" value="1" min="1" />
									</div>
								</div>
							</div>
							<div class="col-12 col-lg-6">
								<label for="contact_map_marker">{{ lang('AdminContents.contactInformation.general.map.icon') }}</label>
								<input type="file" name="contact_map_marker" id="contact_map_marker" class="dropify" data-height="216" />
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
	            <button type="submit" class="btn btn-primary waves-effect waves-light" type="submit" id="custom-form-button1">
	  						<span class="d-none loading-spinner">
	  							<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
	  							<span>{{ lang('Admin.loading') }}</span>
	  						</span>
	  						<span class="button-text">
	  							<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.save') }}</span>
	  						</span>
	  					</button>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}

{% if page_name == 'edit' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/update/'~result.contact_id, 'class="custom-form" enctype="multipart/form-data"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.process.editRecord') }}</h4>
						</div>
						<div class="row">
							<div class="col-12 col-lg-3 mb-3">
								<label for="status">{{ lang('AdminContents.contactInformation.general.status') }} <span class="tx-danger">*</span></label>
								<select name="form[status]" id="status" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}" {{ result.status == FORM_ACTIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}" {{ result.status == FORM_PASSIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.passive') }}</option>
								</select>
							</div>
              <div class="col-12 col-lg-3 mb-3">
                <label for="status_mobile">{{ lang('Admin.mobile') }} <span class="tx-danger">*</span></label>
                <select name="form[status_mobile]" id="status_mobile" class="form-control select2">
                  <option value="">{{ lang('Admin.choose') }}</option>
                  <option value="{{ FORM_ACTIVE_NUMBER }}" {{ result.status_mobile == FORM_ACTIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.active') }}</option>
                  <option value="{{ FORM_PASSIVE_NUMBER }}" {{ result.status_mobile == FORM_PASSIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.passive') }}</option>
                </select>
              </div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_default">{{ lang('AdminContents.contactInformation.general.default') }} <span class="tx-danger">*</span></label>
								<select name="form[contact_default]" id="contact_default" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}" {{ result.contact_default == FORM_ACTIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}" {{ result.contact_default == FORM_PASSIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.passive') }}</option>
								</select>
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_title">{{ lang('AdminContents.contactInformation.general.name') }} <span class="tx-danger">*</span></label>
								{{ form.input('contact_title', lang.data.translations, '', '', '') }}
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_telephone">{{ lang('AdminContents.contactInformation.general.telephone') }}</label>
								<input type="text" name="form[contact_telephone]" id="contact_telephone" class="form-control phone" value="{{ result.contact_telephone }}" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_telephone2">{{ lang('AdminContents.contactInformation.general.telephone2') }}</label>
								<input type="text" name="form[contact_telephone2]" id="contact_telephone2" class="form-control phone" value="{{ result.contact_telephone2 }}" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_mobile">{{ lang('AdminContents.contactInformation.general.mobile') }}</label>
								<input type="text" name="form[contact_mobile]" id="contact_mobile" class="form-control phone" value="{{ result.contact_mobile }}" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_whatsapp">{{ lang('AdminContents.contactInformation.general.whatsapp') }}</label>
								<input type="text" name="form[contact_whatsapp]" id="contact_whatsapp" class="form-control phone" value="{{ result.contact_whatsapp }}" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_fax">{{ lang('AdminContents.contactInformation.general.fax') }}</label>
								<input type="text" name="form[contact_fax]" id="contact_fax" class="form-control phone" value="{{ result.contact_fax }}" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_fax2">{{ lang('AdminContents.contactInformation.general.fax2') }}</label>
								<input type="text" name="form[contact_fax2]" id="contact_fax2" class="form-control phone" value="{{ result.contact_fax2 }}" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_email">{{ lang('AdminContents.contactInformation.general.emailAddress') }}</label>
								<input type="text" name="form[contact_email]" id="contact_email" class="form-control" value="{{ result.contact_email }}" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_email2">{{ lang('AdminContents.contactInformation.general.emailAddress2') }}</label>
								<input type="text" name="form[contact_email2]" id="contact_email2" class="form-control" value="{{ result.contact_email2 }}" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="contact_post_code">{{ lang('AdminContents.contactInformation.general.postCode') }}</label>
								<input type="text" name="form[contact_post_code]" id="contact_post_code" class="form-control" value="{{ result.contact_post_code }}" />
							</div>
							<div class="col-12 col-lg-12 mb-3">
								<label for="contact_map_url">{{ lang('AdminContents.contactInformation.general.mapUrl') }}</label>
								<textarea name="form[contact_map_url]" id="contact_map_url" class="form-control" rows="3">{{ result.contact_map_url }}</textarea>
							</div>
							<div class="col-12 col-lg-12 mb-3">
								<label for="contact_map_url">{{ lang('AdminContents.contactInformation.general.mapEmbed') }}</label>
								<textarea name="form[contact_map_embed_url]" id="contact_map_embed_url" class="form-control" rows="3">{{ result.contact_map_embed_url }}</textarea>
							</div>
							<div class="col-12 col-lg-6 mb-lg-0 mb-3">
								<label for="contact_address">{{ lang('AdminContents.contactInformation.general.address') }}</label>
								{{ form.textarea('contact_address', lang.data.translations, '', '', '') }}
							</div>
							<div class="col-12 col-lg-6">
								<label for="contact_working_hours">{{ lang('AdminContents.contactInformation.general.workingHours') }}</label>
								{{ form.textarea('contact_working_hours', lang.data.translations, '', '', '') }}
							</div>
						</div>
					</div>
				</div>

				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('AdminContents.contactInformation.general.map.title') }}</h4>
						</div>
						<div class="row">
							<div class="col-12 col-lg-6 mb-0 mb-3">
								<div class="row">
									<div class="col-12 col-lg-12 mb-3">
										<label for="contact_map_lat_coordinate">{{ lang('AdminContents.contactInformation.general.map.latCoordinate') }}</label>
										<input type="text" name="form[contact_map_lat_coordinate]" id="contact_map_lat_coordinate" class="form-control" value="{{ result.map.contact_map_lat_coordinate }}" />
									</div>
									<div class="col-12 col-lg-12 mb-3">
										<label for="contact_map_long_coordinate">{{ lang('AdminContents.contactInformation.general.map.longCoordinate') }}</label>
										<input type="text" name="form[contact_map_long_coordinate]" id="contact_map_long_coordinate" class="form-control" value="{{ result.map.contact_map_long_coordinate }}" />
									</div>
									<div class="col-12 col-lg-12">
										<label for="contact_map_zoom">{{ lang('AdminContents.contactInformation.general.map.zoom') }}</label>
										<input type="number" name="form[contact_map_zoom]" id="contact_map_zoom" class="form-control number" value="{{ result.map.contact_map_zoom }}" min="1" />
									</div>
								</div>
							</div>
							<div class="col-12 col-lg-6">
								<label for="contact_map_marker">{{ lang('AdminContents.contactInformation.general.map.icon') }}</label>
								<input type="file" name="contact_map_marker" id="contact_map_marker" class="dropify" data-height="216" data-default-file="{{ result.map.contact_map_marker }}" data-url="{{ result.map.image_remove }}" />
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
							<div class="row">
								<div class="col-12 col-lg-6 text-lg-right text-center mb-lg-0 mb-2">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE1 }}" class="btn btn-primary" id="custom-form-button1">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndStayButton') }}</span>
										</span>
									</button>
								</div>
								<div class="col-12 col-lg-6 text-lg-left text-center">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE2 }}" class="btn btn-secondary" id="custom-form-button2">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndExitButton') }}</span>
										</span>
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}
{% endblock %}
