{% extends BACKEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import BACKEND_TEMPLATE_PATH~'/layouts/form-elements.html.twig' as form %}

{% block body %}
<div class="row">
  <div class="col-sm-12">
    <div class="page-title-box">
      <div class="float-right">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL) }}">{{ lang('Admin.homePage') }}</a></li>
    				<li class="breadcrumb-item"><a href="javascript:void(0)">{{ lang('AdminSultangazi.sultangaziTitle') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL~'/'~page_url) }}">{{ lang('AdminSultangazi.cityGuideContents.title') }}</a></li>
            {% if page_name == 'add' %}
              <li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.process.addNewRecord') }}</li>
            {% endif %}

            {% if page_name == 'edit' %}
              <li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.process.editRecord') }}</li>
            {% endif %}
          </ol>
      </div>
      <h4 class="page-title">{{ lang('AdminSultangazi.cityGuideContents.title') }}</h4>
    </div>
  </div>
</div>

{% if FLASH_DATA_MESSAGE_SUCCESS %}
  <div class="row">
    <div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
      <div class="alert alert-secondary mb-4 alert-dismissible fade show" role="alert">
      	<button type="button" class="close" data-dismiss="alert" aria-label="Close">
      		<span aria-hidden="true">&times;</span>
      	</button>
      	{{ FLASH_DATA_MESSAGE_SUCCESS }}
      </div>
    </div>
  </div>
{% endif %}

{% if page_name == 'city-guide-content-index' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col-12 col-lg-6">
							<div class="main-content-label mb-0 pb-0 border-0">
								<h4 class="header-title">{{ lang('AdminSultangazi.cityGuideContents.title') }}</h4>
							</div>
						</div>
						<div class="col-12 col-lg-6 text-lg-right text-left">
							<a href="{{ base_url(BACKEND_URL~'/'~page_url~'/add') }}" class="btn btn-purple">
								{{ lang('Admin.process.addNewRecord') }}
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-12">
							<div class="table-responsive">
								<table id="datatable" class="table table-bordered dt-responsive nowrap w-100" data-table-url="{{ datatable_url }}">
									<thead>
										<tr>
											<th>{{ lang('AdminSultangazi.cityGuideContents.general.status') }}</th>
                      <th class="no-sort">{{ lang('AdminSultangazi.cityGuideContents.general.logo') }}</th>
                      <th>{{ lang('AdminSultangazi.cityGuideContents.general.category') }}</th>
											<th>{{ lang('AdminSultangazi.cityGuideContents.general.name') }}</th>
                      <th>{{ lang('AdminSultangazi.cityGuideContents.general.telephone') }}</th>
                      <th>{{ lang('AdminSultangazi.cityGuideContents.general.emailAddress') }}</th>
											<th>{{ lang('AdminSultangazi.cityGuideContents.general.createdDate') }}</th>
											<th>{{ lang('AdminSultangazi.cityGuideContents.general.updatedDate') }}</th>
											<th class="no-sort">{{ lang('Admin.process.title') }}</th>
										</tr>
									</thead>
									<tbody></tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endif %}

{% if page_name == 'add' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/insert', 'class="custom-form"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.process.addNewRecord') }}</h4>
						</div>
            <div class="row">
							<div class="col-12 col-lg-6 mb-3">
								<label for="status">{{ lang('AdminSultangazi.cityGuideContents.general.status') }} <span class="tx-danger">*</span></label>
								<select name="form[status]" id="status" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}">{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}">{{ lang('Admin.passive') }}</option>
								</select>
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_name">{{ lang('AdminSultangazi.cityGuideContents.general.name') }} <span class="tx-danger">*</span></label>
								{{ form.input('city_guide_content_name', '', '', '', '') }}
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_person_name_surname">{{ lang('AdminSultangazi.cityGuideContents.general.person.nameSurname') }}</label>
								<input type="text" name="form[city_guide_content_person_name_surname]" id="city_guide_content_person_name_surname" class="form-control" />
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_person_name_sub_title">{{ lang('AdminSultangazi.cityGuideContents.general.person.subTitle') }}</label>
								{{ form.input('city_guide_content_person_name_sub_title', '', '', '', '') }}
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_telephone">{{ lang('AdminSultangazi.cityGuideContents.general.telephone') }}</label>
								<input type="text" name="form[city_guide_content_telephone]" id="city_guide_content_telephone" class="form-control phone" autocomplete="off" />
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_fax">{{ lang('AdminSultangazi.cityGuideContents.general.fax') }}</label>
								<input type="text" name="form[city_guide_content_fax]" id="city_guide_content_fax" class="form-control phone" autocomplete="off" />
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_email_address">{{ lang('AdminSultangazi.cityGuideContents.general.emailAddress') }}</label>
								<input type="text" name="form[city_guide_content_email_address]" id="city_guide_content_email_address" class="form-control" autocomplete="off" />
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_web_address">{{ lang('AdminSultangazi.cityGuideContents.general.webAddress') }}</label>
								<input type="text" name="form[city_guide_content_web_address]" id="city_guide_content_web_address" class="form-control" autocomplete="off" />
							</div>
              <div class="col-12 col-lg-6 mb-3">
                <label for="city_guide_content_lat_coordinate">{{ lang('AdminSultangazi.cityGuideContents.general.map.latCoordinate') }}</label>
                <input type="text" name="form[city_guide_content_lat_coordinate]" id="latitude" class="form-control" autocomplete="off" readonly />
              </div>
              <div class="col-12 col-lg-6 mb-3">
                <label for="city_guide_content_long_coordinate">{{ lang('AdminSultangazi.cityGuideContents.general.map.longCoordinate') }}</label>
                <input type="text" name="form[city_guide_content_long_coordinate]" id="longitude" class="form-control" autocomplete="off" readonly />
              </div>
              <div class="col-12 col-lg-12 mb-3">
                <div class="text-danger mb-2">{{ lang('AdminSultangazi.cityGuideContents.alert.coordinate') }}</div>
                <div id="googleMap"></div>
              </div>
              <div class="col-12 col-lg-6 mb-3">
                <label for="city_guide_content_address">{{ lang('AdminSultangazi.cityGuideContents.general.address') }}</label>
                <textarea name="form[city_guide_content_address]" id="city_guide_content_address" class="form-control" rows="5"></textarea>
              </div>
              <div class="col-12 col-lg-6 mb-3">
                <label for="city_guide_content_description">{{ lang('AdminSultangazi.cityGuideContents.general.description') }}</label>
                {{ form.textarea('city_guide_content_description', '', '', '', '', '') }}
              </div>
              <div class="col-12 col-lg-12">
                <label for="city_guide_content_logo">{{ lang('AdminSultangazi.cityGuideContents.general.logo') }}</label>
                <input type="file" name="city_guide_content_logo" id="city_guide_content_logo" class="dropify" data-height="200" />
              </div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
	            <button type="submit" class="btn btn-primary waves-effect waves-light" type="submit" id="custom-form-button1">
	  						<span class="d-none loading-spinner">
	  							<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
	  							<span>{{ lang('Admin.loading') }}</span>
	  						</span>
	  						<span class="button-text">
	  							<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.save') }}</span>
	  						</span>
	  					</button>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}

{% if page_name == 'edit' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/update/'~result.city_guide_content_id, 'class="custom-form"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.process.editRecord') }}</h4>
						</div>
            <div class="row">
							<div class="col-12 col-lg-6 mb-3">
								<label for="status">{{ lang('AdminSultangazi.cityGuideContents.general.status') }} <span class="tx-danger">*</span></label>
								<select name="form[status]" id="status" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}" {{ result.status == FORM_ACTIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}" {{ result.status == FORM_PASSIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.passive') }}</option>
								</select>
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_name">{{ lang('AdminSultangazi.cityGuideContents.general.name') }} <span class="tx-danger">*</span></label>
								{{ form.input('city_guide_content_name', lang.data.translations, '', '', '') }}
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_person_name_surname">{{ lang('AdminSultangazi.cityGuideContents.general.person.nameSurname') }}</label>
								<input type="text" name="form[city_guide_content_person_name_surname]" id="city_guide_content_person_name_surname" class="form-control" value="{{ result.city_guide_content_person_name_surname }}" />
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_person_name_sub_title">{{ lang('AdminSultangazi.cityGuideContents.general.person.subTitle') }}</label>
								{{ form.input('city_guide_content_person_name_sub_title', lang.data.translations, '', '', '') }}
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_telephone">{{ lang('AdminSultangazi.cityGuideContents.general.telephone') }}</label>
								<input type="text" name="form[city_guide_content_telephone]" id="city_guide_content_telephone" class="form-control phone" value="{{ result.city_guide_content_telephone }}" autocomplete="off" />
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_fax">{{ lang('AdminSultangazi.cityGuideContents.general.fax') }}</label>
								<input type="text" name="form[city_guide_content_fax]" id="city_guide_content_fax" class="form-control phone" value="{{ result.city_guide_content_fax }}" autocomplete="off" />
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_email_address">{{ lang('AdminSultangazi.cityGuideContents.general.emailAddress') }}</label>
								<input type="text" name="form[city_guide_content_email_address]" id="city_guide_content_email_address" class="form-control" value="{{ result.city_guide_content_email_address }}" autocomplete="off" />
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="city_guide_content_web_address">{{ lang('AdminSultangazi.cityGuideContents.general.webAddress') }}</label>
								<input type="text" name="form[city_guide_content_web_address]" id="city_guide_content_web_address" class="form-control" value="{{ result.city_guide_content_web_address }}" autocomplete="off" />
							</div>
              <div class="col-12 col-lg-6 mb-3">
                <label for="city_guide_content_lat_coordinate">{{ lang('AdminSultangazi.cityGuideContents.general.map.latCoordinate') }}</label>
                <input type="text" name="form[city_guide_content_lat_coordinate]" id="latitude" class="form-control" value="{{ result.city_guide_content_lat_coordinate }}" autocomplete="off" readonly />
              </div>
              <div class="col-12 col-lg-6 mb-3">
                <label for="city_guide_content_long_coordinate">{{ lang('AdminSultangazi.cityGuideContents.general.map.longCoordinate') }}</label>
                <input type="text" name="form[city_guide_content_long_coordinate]" id="longitude" class="form-control" value="{{ result.city_guide_content_long_coordinate }}" autocomplete="off" readonly />
              </div>
              <div class="col-12 col-lg-12 mb-3">
                <div class="text-danger mb-2">{{ lang('AdminSultangazi.cityGuideContents.alert.coordinate') }}</div>
                <div id="googleMap"></div>
              </div>
              <div class="col-12 col-lg-6 mb-3">
                <label for="city_guide_content_address">{{ lang('AdminSultangazi.cityGuideContents.general.address') }}</label>
                <textarea name="form[city_guide_content_address]" id="city_guide_content_address" class="form-control" rows="5">{{ result.city_guide_content_address }}</textarea>
              </div>
              <div class="col-12 col-lg-6 mb-3">
                <label for="city_guide_content_description">{{ lang('AdminSultangazi.cityGuideContents.general.description') }}</label>
                {{ form.textarea('city_guide_content_description', lang.data.translations, '', '', '', '') }}
              </div>
              <div class="col-12 col-lg-12">
                <label for="city_guide_content_logo">{{ lang('AdminSultangazi.cityGuideContents.general.logo') }}</label>
                <input type="file" name="city_guide_content_logo" id="city_guide_content_logo" class="dropify" data-height="200" data-default-file="{{ result.logo }}" data-url="{{ result.logo_remove }}" />
              </div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
							<div class="row">
								<div class="col-12 col-lg-6 text-lg-right text-center mb-lg-0 mb-2">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE1 }}" class="btn btn-primary" id="custom-form-button1">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndStayButton') }}</span>
										</span>
									</button>
								</div>
								<div class="col-12 col-lg-6 text-lg-left text-center">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE2 }}" class="btn btn-secondary" id="custom-form-button2">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndExitButton') }}</span>
										</span>
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}
{% endblock %}
