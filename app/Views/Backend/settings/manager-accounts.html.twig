{% extends BACKEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}
{% block body %}
<div class="row">
  <div class="col-sm-12">
    <div class="page-title-box">
      <div class="float-right">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL) }}">{{ lang('Admin.homePage') }}</a></li>
    				<li class="breadcrumb-item"><a href="javascript:void(0)">{{ lang('AdminSettings.settingsTitle') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL~'/'~page_url) }}">{{ lang('AdminSettings.managerAccounts.title') }}</a></li>
            {% if page_name == 'add' %}
              <li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.process.addNewRecord') }}</li>
            {% endif %}

            {% if page_name == 'edit' %}
              <li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.process.editRecord') }}</li>
            {% endif %}

						{% if page_name == 'change-password' %}
							<li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.password.change') }}</li>
						{% endif %}
          </ol>
      </div>
      <h4 class="page-title">{{ lang('AdminSettings.managerAccounts.title') }}</h4>
    </div>
  </div>
</div>

{% if FLASH_DATA_MESSAGE_SUCCESS %}
  <div class="row">
    <div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
      <div class="alert alert-secondary mb-4 alert-dismissible fade show" role="alert">
      	<button type="button" class="close" data-dismiss="alert" aria-label="Close">
      		<span aria-hidden="true">&times;</span>
      	</button>
      	{{ FLASH_DATA_MESSAGE_SUCCESS }}
      </div>
    </div>
  </div>
{% endif %}

{% if page_name == 'index' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col-12 col-lg-6">
							<div class="main-content-label mb-0 pb-0 border-0">
								<h4 class="header-title">{{ lang('AdminSettings.managerAccounts.title') }}</h4>
							</div>
						</div>
						<div class="col-12 col-lg-6 text-lg-right text-left">
							<a href="{{ base_url(BACKEND_URL~'/'~page_url~'/add') }}" class="btn btn-purple">
								{{ lang('Admin.process.addNewRecord') }}
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-12">
							<div class="table-responsive">
								<table id="datatable" class="table table-bordered dt-responsive nowrap w-100" data-table-url="{{ datatable_url }}">
									<thead>
										<tr>
											<th>{{ lang('AdminSettings.managerAccounts.general.status') }}</th>
											<th>{{ lang('AdminSettings.managerAccounts.general.type') }}</th>
											<th>{{ lang('AdminSettings.managerAccounts.general.nameSurname') }}</th>
											<th>{{ lang('AdminSettings.managerAccounts.general.telephone') }}</th>
											<th>{{ lang('AdminSettings.managerAccounts.general.emailAddress') }}</th>
											<th>{{ lang('AdminSettings.managerAccounts.general.lastLoginTime') }}</th>
											<th class="no-sort">{{ lang('Admin.process.title') }}</th>
										</tr>
									</thead>
									<tbody></tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endif %}

{% if page_name == 'add' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/insert', 'class="custom-form" enctype="multipart/form-data"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.process.addNewRecord') }}</h4>
						</div>
						<div class="row">
							<div class="col-12 col-lg-3 mb-3">
								<label for="user_status">{{ lang('AdminSettings.managerAccounts.general.status') }} <span class="tx-danger">*</span></label>
								<select name="form[user_status]" id="user_status" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}">{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}">{{ lang('Admin.passive') }}</option>
								</select>
							</div>
							<div class="col-12 col-lg-3 mb-3">
								<label for="user_type_id">{{ lang('AdminSettings.managerAccounts.general.type') }} <span class="tx-danger">*</span></label>
								{% if user_types != null %}
									<select name="form[user_type_id]" id="user_type_id" class="form-control select2">
										<option value="">{{ lang('Admin.choose') }}</option>
										{% for row in user_types %}
										<option value="{{ row.user_type_id }}">{{ row.user_type_name }}</option>
										{% endfor %}
									</select>
								{% else %}
									<div class="alert alert-danger mb-0" role="alert">{{ lang('Admin.noRecords') }}</div>
								{% endif %}
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="user_name_surname">{{ lang('AdminSettings.managerAccounts.general.nameSurname') }} <span class="tx-danger">*</span></label>
								<input type="text" name="form[user_name_surname]" id="user_name_surname" class="form-control" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="user_telephone">{{ lang('AdminSettings.managerAccounts.general.telephone') }}</label>
								<input type="text" name="form[user_telephone]" id="user_telephone" class="form-control phone" autocomplete="off" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="user_email_address">{{ lang('AdminSettings.managerAccounts.general.emailAddress') }} <span class="tx-danger">*</span></label>
								<input type="text" name="form[user_email_address]" id="user_email_address" class="form-control" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="new_password">{{ lang('AdminSettings.managerAccounts.general.password.title') }} <span class="tx-danger">*</span></label>
								<div class="input-group password-show">
									<input type="password" name="new_password" id="new_password" class="form-control" />
									<div class="input-group-prepend cursor-pointer" data-toggle="tooltip" title="" data-original-title="{{ lang('Admin.password.show') }}">
										<span class="input-group-text"><i class="fas fa-eye"></i></span>
									</div>
								</div>
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="confirm_password">{{ lang('AdminSettings.managerAccounts.general.password.again') }} <span class="tx-danger">*</span></label>
								<div class="input-group password-show">
									<input type="password" name="confirm_password" id="confirm_password" class="form-control" />
									<div class="input-group-prepend cursor-pointer" data-toggle="tooltip" title="" data-original-title="{{ lang('Admin.password.show') }}">
										<span class="input-group-text"><i class="fas fa-eye"></i></span>
									</div>
								</div>
							</div>
							<div class="col-12 col-lg-12">
								<label for="user_image">{{ lang('AdminSettings.managerAccounts.general.image') }}</label>
								<input type="file" name="user_image" id="user_image" class="dropify" data-height="200" />
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
	            <button type="submit" class="btn btn-primary waves-effect waves-light" type="submit" id="custom-form-button1">
	  						<span class="d-none loading-spinner">
	  							<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
	  							<span>{{ lang('Admin.loading') }}</span>
	  						</span>
	  						<span class="button-text">
	  							<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.save') }}</span>
	  						</span>
	  					</button>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}

{% if page_name == 'edit' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/update/'~result.user_id, 'class="custom-form" enctype="multipart/form-data"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.process.editRecord') }}</h4>
						</div>
						<div class="row">
							<div class="col-12 col-lg-3 mb-3">
								<label for="user_status">{{ lang('AdminSettings.managerAccounts.general.status') }} <span class="tx-danger">*</span></label>
								<select name="form[user_status]" id="user_status" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}" {{ result.user_status == FORM_ACTIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}" {{ result.user_status == FORM_PASSIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.passive') }}</option>
								</select>
							</div>
							<div class="col-12 col-lg-3 mb-3">
								<label for="user_type_id">{{ lang('AdminSettings.managerAccounts.general.type') }} <span class="tx-danger">*</span></label>
								{% if user_types != null %}
									<select name="form[user_type_id]" id="user_type_id" class="form-control select2">
										{% for row in user_types %}
										<option value="{{ row.user_type_id }}" {{ row.user_type_id == result.user_type_id ? 'selected' : NULL }}>{{ row.user_type_name }}</option>
										{% endfor %}
									</select>
								{% else %}
									<div class="alert alert-danger mb-0" role="alert">{{ lang('Admin.noRecords') }}</div>
								{% endif %}
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="user_name_surname">{{ lang('AdminSettings.managerAccounts.general.nameSurname') }} <span class="tx-danger">*</span></label>
								<input type="text" name="form[user_name_surname]" id="user_name_surname" class="form-control" value="{{ result.user_name_surname }}" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="user_telephone">{{ lang('AdminSettings.managerAccounts.general.telephone') }}</label>
								<input type="text" name="form[user_telephone]" id="user_telephone" class="form-control phone" value="{{ result.user_telephone }}" autocomplete="off" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="user_email_address">{{ lang('AdminSettings.managerAccounts.general.emailAddress') }} <span class="tx-danger">*</span></label>
								<input type="text" name="form[user_email_address]" id="user_email_address" class="form-control" value="{{ result.user_email_address }}" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<a href="{{ base_url(BACKEND_URL~'/'~page_url~'/change-password/'~result.user_id) }}" class="btn btn-success btn-block rounded-5">
									<i class="fas fa-lock-open"></i> {{ lang('AdminSettings.managerAccounts.changePassword.title') }}
								</a>
							</div>
							<div class="col-12 col-lg-12">
								<label for="user_image">{{ lang('AdminSettings.managerAccounts.general.image') }}</label>
								<input type="file" name="user_image" id="user_image" class="dropify" data-height="200" data-default-file="{{ result.user_image }}" data-url="{{ result.image_remove }}" />
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
							<div class="row">
								<div class="col-12 col-lg-6 text-lg-right text-center mb-lg-0 mb-2">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE1 }}" class="btn btn-primary" id="custom-form-button1">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndStayButton') }}</span>
										</span>
									</button>
								</div>
								<div class="col-12 col-lg-6 text-lg-left text-center">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE2 }}" class="btn btn-secondary" id="custom-form-button2">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndExitButton') }}</span>
										</span>
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}

{% if page_name == 'change-password' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/change-password-update/'~result.user_id, 'class="custom-form"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.password.change') }}</h4>
						</div>
						<div class="row">
							<div class="col-12 col-lg-12 mb-3">
								<p class="mb-0 text-muted card-sub-title">
									{{ lang('AdminSettings.managerAccounts.changePassword.description', [result.user_name_surname]) }}
								</p>
							</div>
							<div class="col-12 col-lg-6 mb-lg-0 mb-3">
								<label for="new_password" class="w-100">
									{{ lang('AdminSettings.managerAccounts.changePassword.newPassword.title') }} <span class="tx-danger">*</span>
								</label>
								<div class="input-group password-show">
									<input type="password" name="new_password" id="new_password" class="form-control" />
									<div class="input-group-prepend cursor-pointer" data-toggle="tooltip" title="" data-original-title="{{ lang('Admin.password.show') }}">
										<span class="input-group-text"><i class="fas fa-eye"></i></span>
									</div>
								</div>
							</div>
							<div class="col-12 col-lg-6">
								<label for="confirm_password" class="w-100">
									{{ lang('AdminSettings.managerAccounts.changePassword.newPassword.again') }} <span class="tx-danger">*</span>
								</label>
								<div class="input-group password-show">
									<input type="password" name="confirm_password" id="confirm_password" class="form-control" />
									<div class="input-group-prepend cursor-pointer" data-toggle="tooltip" title="" data-original-title="{{ lang('Admin.password.show') }}">
										<span class="input-group-text"><i class="fas fa-eye"></i></span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
	            <button type="submit" class="btn btn-primary waves-effect waves-light" type="submit" id="custom-form-button1">
	  						<span class="d-none loading-spinner">
	  							<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
	  							<span>{{ lang('Admin.loading') }}</span>
	  						</span>
	  						<span class="button-text">
	  							<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.save') }}</span>
	  						</span>
	  					</button>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}
{% endblock %}
