{% extends BACKEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}
{% block body %}
<div class="row">
  <div class="col-sm-12">
    <div class="page-title-box">
      <div class="float-right">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL) }}">{{ lang('Admin.homePage') }}</a></li>
    				<li class="breadcrumb-item"><a href="javascript:void(0)">{{ lang('AdminSettings.settingsTitle') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL~'/'~page_url) }}">{{ lang('AdminSettings.languageManagement.title') }}</a></li>
            {% if page_name == 'edit' %}
              <li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.process.editRecord') }}</li>
            {% endif %}
          </ol>
      </div>
      <h4 class="page-title">{{ lang('AdminSettings.languageManagement.title') }}</h4>
    </div>
  </div>
</div>

{% if FLASH_DATA_MESSAGE_SUCCESS %}
  <div class="row">
    <div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
      <div class="alert alert-secondary mb-4 alert-dismissible fade show" role="alert">
      	<button type="button" class="close" data-dismiss="alert" aria-label="Close">
      		<span aria-hidden="true">&times;</span>
      	</button>
      	{{ FLASH_DATA_MESSAGE_SUCCESS }}
      </div>
    </div>
  </div>
{% endif %}

{% if page_name == 'index' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-12">
							<div class="table-responsive">
								<table id="datatable" class="table table-bordered dt-responsive nowrap w-100" data-table-url="{{ datatable_url }}">
									<thead>
										<tr>
											<th>{{ lang('AdminSettings.languageManagement.general.status') }}</th>
											<th>{{ lang('AdminSettings.languageManagement.general.code') }}</th>
											<th>{{ lang('AdminSettings.languageManagement.general.title') }}</th>
											<th>{{ lang('AdminSettings.languageManagement.general.setLocale') }}</th>
											<th>{{ lang('AdminSettings.languageManagement.general.flag') }}</th>
											<th>{{ lang('AdminSettings.languageManagement.general.default.frontend') }}</th>
											<th>{{ lang('AdminSettings.languageManagement.general.default.backend') }}</th>
											<th class="no-sort">{{ lang('Admin.process.title') }}</th>
										</tr>
									</thead>
									<tbody></tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endif %}

{% if page_name == 'edit' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/update/'~result.lang_id, 'class="custom-form"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.process.editRecord') }}</h4>
						</div>
						<div class="row">
							<div class="col-12 col-lg-6 mb-3">
								<label for="lang_status">{{ lang('AdminSettings.languageManagement.general.status') }} <span class="tx-danger">*</span></label>
								<select name="form[lang_status]" id="lang_status" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}" {{ result.lang_status == FORM_ACTIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}" {{ result.lang_status == FORM_PASSIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.passive') }}</option>
								</select>
							</div>
							<div class="col-12 col-lg-3 mb-3">
								<label for="lang_code">{{ lang('AdminSettings.languageManagement.general.code') }} <span class="tx-danger">*</span></label>
								<input type="text" name="form[lang_code]" id="lang_code" class="form-control" value="{{ result.lang_code }}" />
							</div>
							<div class="col-12 col-lg-3 mb-3">
								<label for="lang_title">{{ lang('AdminSettings.languageManagement.general.title') }} <span class="tx-danger">*</span></label>
								<input type="text" name="form[lang_title]" id="lang_title" class="form-control" value="{{ result.lang_title }}" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="lang_set_locale">{{ lang('AdminSettings.languageManagement.general.setLocale') }} <span class="tx-danger">*</span></label>
								{% if list.setLocale != null %}
									<select name="form[lang_set_locale]" id="lang_set_locale" class="form-control select2">
										{% for row in list.setLocale %}
										<option value="{{ row.set_locale_code }}" {{ row.set_locale_code == result.lang_set_locale ? 'selected' : NULL }}>{{ row.set_locale_name }} - {{ row.set_locale_code }}</option>
										{% endfor %}
									</select>
								{% else %}
									<div class="alert alert-danger mb-0" role="alert">{{ lang('Admin.noRecords') }}</div>
								{% endif %}
							</div>
							<div class="col-12 col-lg-6 mb-lg-0 mb-3">
								<label for="lang_icon">{{ lang('AdminSettings.languageManagement.general.flag') }}</label>
								<select name="form[lang_icon]" id="lang_icon" class="form-control select2">
									{% if list.flags != null %}
										{% for row in list.flags %}
										<option value="{{ row.file }}" data-image="{{ base_url(PARAMETER.FILE_PATH_FLAGS~row.file) }}" {{ row.file == result.lang_icon ? 'selected' : NULL }}>{{ row.file }}</option>
										{% endfor %}
									{% endif %}
								</select>
							</div>
							<div class="col-12 col-lg-6">
								<label for="lang_percentage_location">{{ lang('AdminSettings.languageManagement.general.percentageLocation.title') }}</label>
								<select name="form[lang_percentage_location]" id="lang_percentage_location" class="form-control select2">
									<option value="{{ PARAMETER.LANGUAGES_PERCENTAGE_LOCATION_LEFT }}" {{ result.lang_percentage_location == PARAMETER.LANGUAGES_PERCENTAGE_LOCATION_LEFT ? 'selected' : NULL }}>{{ lang('AdminSettings.languageManagement.general.percentageLocation.left') }}</option>
									<option value="{{ PARAMETER.LANGUAGES_PERCENTAGE_LOCATION_RIGHT }}" {{ result.lang_percentage_location == PARAMETER.LANGUAGES_PERCENTAGE_LOCATION_RIGHT ? 'selected' : NULL }}>{{ lang('AdminSettings.languageManagement.general.percentageLocation.right') }}</option>
								</select>
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
							<div class="row">
								<div class="col-12 col-lg-6 text-lg-right text-center mb-lg-0 mb-2">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE1 }}" class="btn btn-primary" id="custom-form-button1">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndStayButton') }}</span>
										</span>
									</button>
								</div>
								<div class="col-12 col-lg-6 text-lg-left text-center">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE2 }}" class="btn btn-secondary" id="custom-form-button2">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndExitButton') }}</span>
										</span>
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}
{% endblock %}
