{% extends BACKEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}
{% block body %}
<div class="row">
  <div class="col-sm-12">
    <div class="page-title-box">
      <div class="float-right">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL) }}">{{ lang('Admin.homePage') }}</a></li>
    				<li class="breadcrumb-item"><a href="javascript:void(0)">{{ lang('AdminSettings.settingsTitle') }}</a></li>
    				<li class="breadcrumb-item active">{{ lang('AdminSettings.socialMedia.title') }}</li>
          </ol>
      </div>
      <h4 class="page-title">{{ lang('AdminSettings.socialMedia.title') }}</h4>
    </div>
  </div>
</div>

{% if FLASH_DATA_MESSAGE_SUCCESS %}
  <div class="row">
    <div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
      <div class="alert alert-secondary mb-4 alert-dismissible fade show" role="alert">
      	<button type="button" class="close" data-dismiss="alert" aria-label="Close">
      		<span aria-hidden="true">&times;</span>
      	</button>
      	{{ FLASH_DATA_MESSAGE_SUCCESS }}
      </div>
    </div>
  </div>
{% endif %}

<div class="row">
	<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
		{{ form_open(BACKEND_URL~'/'~page_url~'/update', 'class="custom-form"') }}
			<div class="card">
				<div class="card-body">
					<div class="main-content-label">
						<h4 class="header-title">{{ lang('AdminSettings.socialMedia.title') }}</h4>
					</div>
					<div class="row">
						<div class="col-lg-6 mb-3">
							<label for="facebook">{{ lang('AdminSettings.socialMedia.links.facebook') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-facebook"></i></span>
								</div>
								<input type="text" name="form[facebook]" id="facebook" class="form-control" value="{{ result.facebook }}" />
							</div>
						</div>
						<div class="col-lg-6 mb-3">
							<label for="twitter">{{ lang('AdminSettings.socialMedia.links.twitter') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-twitter"></i></span>
								</div>
								<input type="text" name="form[twitter]" id="twitter" class="form-control" value="{{ result.twitter }}" />
							</div>
						</div>
						<div class="col-lg-6 mb-3">
							<label for="instagram">{{ lang('AdminSettings.socialMedia.links.instagram') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-instagram"></i></span>
								</div>
								<input type="text" name="form[instagram]" id="instagram" class="form-control" value="{{ result.instagram }}" />
							</div>
						</div>
						<div class="col-lg-6 mb-3">
							<label for="youtube">{{ lang('AdminSettings.socialMedia.links.youtube') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-youtube"></i></span>
								</div>
								<input type="text" name="form[youtube]" id="youtube" class="form-control" value="{{ result.youtube }}" />
							</div>
						</div>
						<div class="col-lg-6 mb-3">
							<label for="linkedin">{{ lang('AdminSettings.socialMedia.links.linkedin') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-linkedin"></i></span>
								</div>
								<input type="text" name="form[linkedin]" id="linkedin" class="form-control" value="{{ result.linkedin }}" />
							</div>
						</div>
						<div class="col-lg-6 mb-3">
							<label for="dribbble">{{ lang('AdminSettings.socialMedia.links.dribbble') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-dribbble"></i></span>
								</div>
								<input type="text" name="form[dribbble]" id="dribbble" class="form-control" value="{{ result.dribbble }}" />
							</div>
						</div>
						<div class="col-lg-6 mb-3">
							<label for="vimeo">{{ lang('AdminSettings.socialMedia.links.vimeo') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-vimeo"></i></span>
								</div>
								<input type="text" name="form[vimeo]" id="vimeo" class="form-control" value="{{ result.vimeo }}" />
							</div>
						</div>
						<div class="col-lg-6 mb-3">
							<label for="pinterest">{{ lang('AdminSettings.socialMedia.links.pinterest') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-pinterest"></i></span>
								</div>
								<input type="text" name="form[pinterest]" id="pinterest" class="form-control" value="{{ result.pinterest }}" />
							</div>
						</div>
						<div class="col-lg-6 mb-lg-0 mb-3">
							<label for="behance">{{ lang('AdminSettings.socialMedia.links.behance') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-behance"></i></span>
								</div>
								<input type="text" name="form[behance]" id="behance" class="form-control" value="{{ result.behance }}" />
							</div>
						</div>
						<div class="col-lg-6">
							<label for="reddit">{{ lang('AdminSettings.socialMedia.links.reddit') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-reddit"></i></span>
								</div>
								<input type="text" name="form[reddit]" id="reddit" class="form-control" value="{{ result.reddit }}" />
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="card mb-0">
				<div class="card-body">
					<div class="text-center">
            <button type="submit" class="btn btn-primary waves-effect waves-light" type="submit" id="custom-form-button1">
  						<span class="d-none loading-spinner">
  							<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
  							<span>{{ lang('Admin.loading') }}</span>
  						</span>
  						<span class="button-text">
  							<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.save') }}</span>
  						</span>
  					</button>
					</div>
				</div>
			</div>
		{{ form_close() }}
	</div>
</div>
{% endblock %}
