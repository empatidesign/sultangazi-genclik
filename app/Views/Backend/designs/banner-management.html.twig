{% extends BACKEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import BACKEND_TEMPLATE_PATH~'/layouts/form-elements.html.twig' as form %}

{% block body %}
<div class="row">
  <div class="col-sm-12">
    <div class="page-title-box">
      <div class="float-right">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL) }}">{{ lang('Admin.homePage') }}</a></li>
    				<li class="breadcrumb-item"><a href="javascript:void(0)">{{ lang('AdminDesigns.designsTitle') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL~'/'~page_url) }}">{{ lang('AdminDesigns.bannerManagement.title') }}</a></li>
						{% if page_name == 'add' %}
							<li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.process.addNewRecord') }}</li>
						{% endif %}

						{% if page_name == 'edit' %}
							<li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.process.editRecord') }}</li>
						{% endif %}
          </ol>
      </div>
      <h4 class="page-title">{{ lang('AdminDesigns.bannerManagement.title') }}</h4>
    </div>
  </div>
</div>

{% if FLASH_DATA_MESSAGE_SUCCESS %}
  <div class="row">
    <div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
      <div class="alert alert-secondary mb-4 alert-dismissible fade show" role="alert">
      	<button type="button" class="close" data-dismiss="alert" aria-label="Close">
      		<span aria-hidden="true">&times;</span>
      	</button>
      	{{ FLASH_DATA_MESSAGE_SUCCESS }}
      </div>
    </div>
  </div>
{% endif %}

{% if page_name == 'index' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col-12 col-lg-6">
							<div class="main-content-label mb-0 pb-0 border-0">
								<h4 class="header-title">{{ lang('AdminDesigns.bannerManagement.title') }}</h4>
							</div>
						</div>
						<div class="col-12 col-lg-6 text-lg-right text-left">
							<a href="{{ base_url(BACKEND_URL~'/'~page_url~'/add') }}" class="btn btn-purple">
								{{ lang('Admin.process.addNewRecord') }}
							</a>
						</div>
					</div>
          <div id="accordionParent" class="accordion">
						<div class="card mb-0 border">
							<div id="FilterContent" class="card-header p-0">
								<h5 class="my-1">
									<button type="button" class="btn btn-link btn-block collapsed text-dark text-left" data-toggle="collapse" data-target="#Filter" aria-expanded="true">
										<i class="fas fa-filter mr-2"></i> {{ lang('Admin.filter.title') }}
									</button>
								</h5>
							</div>
							<div id="Filter" class="collapse" aria-labelledby="FiltreleContent" data-parent="#accordionParent" style="">
								{{ form_open(BACKEND_URL~'/'~page_url, 'method="GET" id="searchForm"') }}
									<div class="card-body">
										<div class="form-row">
											<div class="col-md-6 mb-3">
												<label for="banner_type">{{ lang('AdminDesigns.bannerManagement.general.types.title') }}</label>
												<select name="banner_type" id="banner_type" class="form-control select2">
                          <option value="">{{ lang('Admin.string.choose') }}</option>
                          {% if list.types != null %}
                            {% for key, row in list.types %}
                            <option value="{{ key }}">{{ row }}</option>
                            {% endfor %}
                          {% endif %}
                        </select>
											</div>
                      <div class="col-md-6 mb-3">
                        <label for="banner_name">{{ lang('AdminDesigns.bannerManagement.general.name') }}</label>
                        <input type="text" name="banner_name" id="banner_name" class="form-control" />
                      </div>
											<div class="col-md-12 text-right">
												<button type="submit" class="btn btn-primary">{{ lang('Admin.filter.button.filter') }}</button>
											</div>
										</div>
									</div>
								{{ form_close() }}
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="alert alert-warning" role="alert">
				<strong>{{ lang('Admin.warning.title') }}:</strong> {{ lang('AdminDesigns.bannerManagement.alert.order', ['<i class="fas fa-sort"></i>']) }}
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			<div class="row" id="sortable" data-url="{{ base_url(BACKEND_URL~'/'~page_url~'/sort') }}">
				{% if list.banners != null %}
					{% for row in list.banners %}
					<div class="col-xl-4 col-lg-4 col-md-12" id="item-{{ row.banner_id }}">
						<div class="card text-center">
							<img src="{{ base_url(file_path~'/'~row.banner_web_image) }}" class="card-img-top w-100" title="" alt="" />
							<div class="card-body">
                <span class="font-weight-bold">{{ row.banner_type }}</span>
								<h4 class="card-title mb-3">{{ row.banner_name }}</h4>

                {% if row.dates.start == true and row.dates.end == true %}
                  <div class="text-center text-muted mb-1">
                    <span class="tag text-danger">{{ lang('AdminDesigns.bannerManagement.general.dates.plan') }}</span>
                  </div>
                {% endif %}

								<div class="text-center text-muted mb-1">
									<span class="tag tag-gray">{{ lang('AdminDesigns.bannerManagement.general.createdDate') }}: {{ row.dates.created }}</span>
								</div>
								<div class="text-center text-muted mb-3">
									<span class="tag tag-danger">{{ lang('AdminDesigns.bannerManagement.general.updatedDate') }}: {{ row.dates.updated }}</span>
								</div>
								{{ form.buttonSort('', lang('Admin.process.sortBy'), 'top', '', 'sort-by-box') }}
								{{ form.buttonEdit(lang('Admin.process.edit'), 'top', BACKEND_URL~'/'~page_url, row.banner_id, '') }}
								{{ form.buttonDelete(lang('Admin.process.delete'), 'top', BACKEND_URL~'/'~page_url, row.banner_id, '', 'customDelete') }}
							</div>
						 </div>
					</div>
					{% endfor %}
				{% else %}
					<div class="col-md-12">
						<div class="alert alert-danger mg-b-0" role="alert">{{ lang('Admin.error.noRecord') }}</div>
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endif %}

{% if page_name == 'add' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/insert', 'class="custom-form"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.process.addNewRecord') }}</h4>
						</div>
						<div class="row">
							<div class="col-12 col-lg-3 mb-3">
								<label for="status">{{ lang('AdminDesigns.bannerManagement.general.status') }} <span class="tx-danger">*</span></label>
								<select name="form[status]" id="status" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}">{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}">{{ lang('Admin.passive') }}</option>
								</select>
							</div>
              <div class="col-12 col-lg-3 mb-3">
								<label for="status_mobile">{{ lang('Admin.mobile') }} <span class="tx-danger">*</span></label>
								<select name="form[status_mobile]" id="status_mobile" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}">{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}">{{ lang('Admin.passive') }}</option>
								</select>
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="banner_type">{{ lang('AdminDesigns.bannerManagement.general.types.title') }} <span class="tx-danger">*</span></label>
								<select name="form[banner_type]" id="banner_type" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									{% if list.types != null %}
                    {% for key, row in list.types %}
                    <option value="{{ key }}">{{ row }}</option>
                    {% endfor %}
									{% endif %}
								</select>
							</div>
							<div class="col-12 col-lg-12 mb-3">
								<label for="banner_name">{{ lang('AdminDesigns.bannerManagement.general.name') }} <span class="tx-danger">*</span></label>
								{{ form.input('banner_name', '', '', '', '') }}
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="banner_web_image">{{ lang('AdminDesigns.bannerManagement.general.image.web') }}</label>
								<input type="file" name="banner_web_image" id="banner_web_image" class="dropify" data-height="200" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="banner_mobile_image">{{ lang('AdminDesigns.bannerManagement.general.image.mobile') }}</label>
								<input type="file" name="banner_mobile_image" id="banner_mobile_image" class="dropify" data-height="200" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="banner_link">{{ lang('AdminDesigns.bannerManagement.general.button.link') }}</label>
								{{ form.input('banner_link', '', '', '', '') }}
							</div>
							<div class="col-12 col-lg-6 mb-lg-3 mb-5">
								<label for="banner_link_target">{{ lang('AdminDesigns.bannerManagement.general.button.linkTarget') }}</label>
								<div class="custom-switch switch-primary">
									<input type="checkbox" name="form[banner_link_target]" id="banner_link_target" class="custom-control-input" value="{{ FORM_CHECKBOX_VALUE_NUMBER }}" />
									<label for="banner_link_target" class="custom-control-label"></label>
								</div>
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="banner_showing_date">{{ lang('AdminDesigns.bannerManagement.general.dates.title') }}</label>
								<input type="text" name="banner_showing_date" id="banner_showing_date" class="form-control daterange" autocomplete="off" />
                {{ form.help(lang('AdminDesigns.bannerManagement.general.dates.description')) }}
							</div>
							<div class="col-12 col-lg-12">
								<label for="banner_description">{{ lang('AdminDesigns.bannerManagement.general.description') }}</label>
								{{ form.textarea('banner_description', '', '', 'textarea_editor', '', '') }}
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
	            <button type="submit" class="btn btn-primary waves-effect waves-light" type="submit" id="custom-form-button1">
	  						<span class="d-none loading-spinner">
	  							<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
	  							<span>{{ lang('Admin.loading') }}</span>
	  						</span>
	  						<span class="button-text">
	  							<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.save') }}</span>
	  						</span>
	  					</button>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}

{% if page_name == 'edit' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/update/'~result.banner_id, 'class="custom-form"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.process.editRecord') }}</h4>
						</div>
						<div class="row">
							<div class="col-12 col-lg-3 mb-3">
								<label for="status">{{ lang('AdminDesigns.bannerManagement.general.status') }} <span class="tx-danger">*</span></label>
								<select name="form[status]" id="status" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}" {{ result.status == FORM_ACTIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}" {{ result.status == FORM_PASSIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.passive') }}</option>
								</select>
							</div>
              <div class="col-12 col-lg-3 mb-3">
								<label for="status_mobile">{{ lang('Admin.mobile') }} <span class="tx-danger">*</span></label>
								<select name="form[status_mobile]" id="status_mobile" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}" {{ result.status_mobile == FORM_ACTIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}" {{ result.status_mobile == FORM_PASSIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.passive') }}</option>
								</select>
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="banner_type">{{ lang('AdminDesigns.bannerManagement.general.types.title') }} <span class="tx-danger">*</span></label>
								<select name="form[banner_type]" id="banner_type" class="form-control select2">
									{% if list.types != null %}
                    {% for key, row in list.types %}
                    <option value="{{ key }}" {{ key == result.banner_type ? 'selected' : null }}>{{ row }}</option>
                    {% endfor %}
									{% endif %}
								</select>
							</div>
							<div class="col-12 col-lg-12 mb-3">
								<label for="banner_name">{{ lang('AdminDesigns.bannerManagement.general.name') }} <span class="tx-danger">*</span></label>
								{{ form.input('banner_name', lang.data.translations, '', '', '') }}
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="banner_web_image">{{ lang('AdminDesigns.bannerManagement.general.image.web') }}</label>
								<input type="file" name="banner_web_image" id="banner_web_image" class="dropify" data-height="200" data-default-file="{{ result.banner_web_image }}" data-url="{{ result.image_remove }}?action=web" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="banner_mobile_image">{{ lang('AdminDesigns.bannerManagement.general.image.mobile') }}</label>
								<input type="file" name="banner_mobile_image" id="banner_mobile_image" class="dropify" data-height="200" data-default-file="{{ result.banner_mobile_image }}" data-url="{{ result.image_remove }}?action=mobile" />
							</div>
							<div class="col-12 col-lg-6 mb-3">
								<label for="banner_link">{{ lang('AdminDesigns.bannerManagement.general.button.link') }}</label>
								{{ form.input('banner_link', lang.data.translations, '', '', '') }}
							</div>
							<div class="col-12 col-lg-6 mb-lg-3 mb-5">
								<label for="banner_link_target">{{ lang('AdminDesigns.bannerManagement.general.button.linkTarget') }}</label>
								<div class="custom-switch switch-primary">
									<input type="checkbox" name="form[banner_link_target]" id="banner_link_target" class="custom-control-input" value="{{ FORM_CHECKBOX_VALUE_NUMBER }}" {{ result.banner_link_target == FORM_CHECKBOX_VALUE_NUMBER ? 'checked' : NULL }} />
									<label for="banner_link_target" class="custom-control-label"></label>
								</div>
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="banner_showing_date">{{ lang('AdminDesigns.bannerManagement.general.dates.title') }}</label>
								<input type="text" name="banner_showing_date" id="banner_showing_date" class="form-control daterange" value="{{ result.dates.start }}{{ result.dates.end }}" autocomplete="off" />
                {{ form.help(lang('AdminDesigns.bannerManagement.general.dates.description')) }}
							</div>
							<div class="col-12 col-lg-12">
								<label for="banner_description">{{ lang('AdminDesigns.bannerManagement.general.description') }}</label>
								{{ form.textarea('banner_description', lang.data.translations, '', 'textarea_editor', '', '') }}
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
							<div class="row">
								<div class="col-12 col-lg-6 text-lg-right text-center mb-lg-0 mb-2">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE1 }}" class="btn btn-primary" id="custom-form-button1">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndStayButton') }}</span>
										</span>
									</button>
								</div>
								<div class="col-12 col-lg-6 text-lg-left text-center">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE2 }}" class="btn btn-secondary" id="custom-form-button2">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndExitButton') }}</span>
										</span>
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}
{% endblock %}
