<html>

<head>
<meta charset="UTF-8">
</head>

<body bgcolor="#EDEDED">
	<table width="100%" border="0" align="center" cellpadding="0" cellspacing="0">
		<tr>
			<td bgcolor="#EDEDED" style="padding:30px 0px 30px 0px;">
				<table width="700" border="0" align="center" cellpadding="0" cellspacing="0" bgcolor="#FFFFFF">
					<tr>
						<td width="700" height="100" bgcolor="#FFFFFF" align="center" style="border-bottom:#E0E0E0 1px solid;">
							{% if result.logo != null %}
								<img src="{{ result.logo }}" width="200" alt="" />
							{% endif %}
						</td>
					</tr>
				</table>
				<table width="700" border="0" align="center" cellpadding="0" cellspacing="0" bgcolor="#FFFFFF">
					<tr>
						<td width="700" align="center" valign="middle" bgcolor="#FFFFFF" style="padding:40px 20px 30px 20px;">
							<span style="font-family:Arial, Verdana, Helvetica; color:#023183; font-size:25px; line-height:30px; font-weight:bold;">{{ result.email_title }}</span>
						</td>
					</tr>
				</table>
				<table width="700" border="0" align="center" cellpadding="0" cellspacing="0" bgcolor="#FFFFFF">
					<tr>
						<td width="700" align="left" valign="middle" bgcolor="#FFFFFF"
							style="padding:0px 20px 5px 20px;">
							<span style="font-family:Arial, Verdana, Helvetica; color:#3A3A3A; font-size:15px; line-height:24px; font-weight:normal;">
								{{ result.email_content|raw }}
							</span>
						</td>
					</tr>
				</table>
				<table width="700" border="0" align="center" cellpadding="0" cellspacing="0" bgcolor="#FFFFFF">
					<tr>
						<td width="700" height="30" align="center" valign="middle" bgcolor="#FFFFFF"></td>
					</tr>
				</table>
				<table width="700" border="0" align="center" cellpadding="0" cellspacing="0" bgcolor="#FFFFFF">
					<tr>
						<td width="380" height="80" align="center" valign="middle" bgcolor="#FFFFFF" style="padding-left:30px; border-top:#EDEDED 1px solid;">
							<span style="font-family:Arial, Verdana, Helvetica; color:#1E3480; font-size:16px; font-weight:bold;">{{ base_url() }}</span>
						</td>
					</tr>
				</table>

				{% if result.social_media != null %}
				<table width="700" border="0" align="center" cellpadding="0" cellspacing="0" bgcolor="#EDEDED">
					<tr>
						 <td width="380" height="80" align="left" valign="middle" bgcolor="#EDEDED" style="padding-left:30px;">
							<span></span>
						</td>

						{% if result.social_media.facebook != null %}
						<td width="50" height="50" align="center" valign="middle" bgcolor="#EDEDED">
							<a href="{{ result.social_media.facebook }}"><img src="{{ base_url('assets/mail-template/facebook-ico.png') }}" border="0" width="50" height="50" alt="" /></a>
						</td>
						{% endif %}

						{% if result.social_media.twitter != null %}
						<td width="50" height="50" align="center" valign="middle" bgcolor="#EDEDED">
							<a href="{{ result.social_media.twitter }}"><img src="{{ base_url('assets/mail-template/twitter-ico.png') }}" border="0" width="50" height="50" alt="" /></a>
						</td>
						{% endif %}

						{% if result.social_media.instagram != null %}
						<td width="50" height="50" align="center" valign="middle" bgcolor="#EDEDED">
							<a href="{{ result.social_media.instagram }}"><img src="{{ base_url('assets/mail-template/instagram-ico.png') }}" border="0" width="50" height="50" alt="" /></a>
						</td>
						{% endif %}

						<td width="10" height="50" align="center" valign="middle" bgcolor="#EDEDED"></td>
					</tr>
				</table>
				{% endif %}

				{% if result.contact != null %}
				<table width="700" border="0" align="center" cellpadding="0" cellspacing="0" bgcolor="#EDEDED">
					<tr>
						<td width="700" align="center" valign="middle" bgcolor="#EDEDED">
							<span style="font-family:Arial, Verdana, Helvetica; color:#7790B1; font-size:12px; line-height:18px; font-weight:normal;">
								{{ result.contact.contact_address }}<br />
								{{ result.contact.contact_telephone }} - {{ result.contact.contact_email }}
							</span>
						</td>
					</tr>
				</table>
				{% endif %}
			</td>
		</tr>
	</table>
</body>

</html>
