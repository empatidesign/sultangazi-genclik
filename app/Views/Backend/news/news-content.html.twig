												{{ form.help(lang('Admin.seo.title')) }}
											</div>
											<div class="col-12 col-lg-12 mb-3">
												<label for="news_meta_keywords">{{ lang('AdminNews.news.general.seo.keywords') }}</label>
												{{ form.textarea('news_meta_keywords', lang.data.translations, '', '', '') }}
												{{ form.help(lang('Admin.seo.keywords')) }}
											</div>
											<div class="col-12 col-lg-12 mb-3">
												<label for="news_meta_description">{{ lang('AdminNews.news.general.seo.description') }}</label>
												{{ form.textarea('news_meta_description', lang.data.translations, '', '', '', '') }}
												{{ form.help(lang('Admin.seo.description')) }}
											</div>
											<div class="col-12 col-lg-12">
												<label for="news_slug">{{ lang('AdminNews.news.general.seo.slug') }}</label>
												{{ form.input('news_slug', lang.data.translations, '', '', '') }}
												{{ form.help(lang('Admin.seo.slug')) }}
											</div>
										</div>
									</div>
									<div class="tab-pane" id="tab3">
										<div class="example mb-0">
											<div class="highlight clip-widget mt-0 mb-3 p-3">
												<h6 class="card-title m-0">
													<i class="fas fa-random"></i>
													{{ lang('AdminNews.news.paragraphs.title') }}
												</h6>
											</div>
											<div class="table-responsive">
												<table id="datatable2" class="table table-bordered dt-responsive nowrap w-100" data-table-url="{{ paragraphs.datatable_url }}">
													<thead>
														<tr>
															<th>{{ lang('Admin.id') }}</th>
															<th class="no-sort">{{ lang('AdminNews.news.paragraphs.image') }}</th>
															<th>{{ lang('AdminNews.news.paragraphs.name') }}</th>
															<th>{{ lang('AdminNews.news.paragraphs.createdDate') }}</th>
															<th class="no-sort">{{ lang('Admin.process.title') }}</th>
														</tr>
													</thead>
													<tbody></tbody>
												</table>
											</div>
											<div class="border-top mt-3 pt-3"></div>
											<a href="javascript:void(0)" onclick="modalPage('news_paragraph_add', {{ result.news_id }})" class="btn btn-light">
												<i class="fas fa-plus"></i>
												{{ lang('Admin.process.addNewRecord') }}
											</a>
										</div>
									</div>
									<div class="tab-pane" id="tab4">
										<div id="tab-pictures" data-id="{{ result.news_id }}" data-page-url="{{ page_url }}">
											<div class="portlet-body">
												<div class="row" id="showcase-picture-grid"></div>
												<div id="file-upload-area"></div>
											</div>
											<div id="file-upload-area"></div>
											<script type="text/template" id="qq-template">
												<div class="qq-uploader-selector qq-uploader">
													<div class="qq-upload-drop-area-selector fine-uploader-file-area dz-clickable">
														<i class="fas fa-cloud-upload-alt text-primary" style="font-size:110px;"></i>
														<h4 class="sbold">{{ lang('Admin.fineUploader.messages.dragDrop') }}</h4>
														<p>{{ lang('Admin.fineUploader.messages.dragDropDesc') }}</p>
														<div class="qq-upload-button-selector qq-upload-button btn btn-primary" style="width:200px; margin:0 auto;">
															<div>
																<i class="fas fa-cloud-upload-alt"></i>
																{{ lang('Admin.button.upload') }}</div>
														</div>
													</div>
													<span class="qq-drop-processing-selector qq-drop-processing">
														<span>common.fileuploader.processing</span>
														<span class="qq-drop-processing-spinner-selector qq-drop-processing-spinner"></span>
													</span>
													<ul class="qq-upload-list-selector qq-upload-list">
														<li>
															<div class="qq-progress-bar-container-selector">
																<div class="qq-progress-bar-selector qq-progress-bar"></div>
															</div>
															<span class="qq-upload-spinner-selector qq-upload-spinner"></span>
															<span class="qq-edit-filename-icon-selector qq-edit-filename-icon"></span>
															<span class="qq-upload-file-selector qq-upload-file"></span>
															<input class="qq-edit-filename-selector qq-edit-filename" tabindex="0" type="text">
															<span class="qq-upload-size-selector qq-upload-size"></span>
															<a class="qq-upload-cancel-selector qq-upload-cancel" href="#">common.fileuploader.cancel</a>
															<a class="qq-upload-retry-selector qq-upload-retry" href="#">{{ lang('Admin.tryAgain') }}</a>
															<a class="qq-upload-delete-selector qq-upload-delete" href="#">common.fileuploader.delete</a>
															<span class="qq-upload-status-text-selector qq-upload-status-text"></span>
														</li>
													</ul>
												</div>
											</script>
										</div>
									</div>
									<div class="tab-pane" id="tab5">
										<select name="form[directorates_id][]" id="directorates_id" class="form-control multi-select" multiple>
											{% if list.directorates != null %}
												{% for row in list.directorates %}
													<option value="{{ row.directorates_id }}" {{ row.selected }}>{{ row.directorates_name }}</option>
												{% endfor %}
											{% endif %}
										</select>
									</div>
									<div class="tab-pane" id="tab6">
										<div class="row row-sm">
											<div class="col-12 col-lg-12 mb-5">
												<label for="push_notification">{{ lang('Admin.pushNotification') }}</label>
												<div class="custom-switch switch-primary">
													<input type="checkbox" name="form[push_notification]" id="push_notification" class="custom-control-input" value="{{ FORM_CHECKBOX_VALUE_NUMBER }}" {{ result.push_notification == FORM_ACTIVE_NUMBER ? 'checked' : NULL }}/>
													<label for="push_notification" class="custom-control-label"></label>
												</div>
											</div>
											<div class="col-12 col-lg-12 mb-3">
												<label for="news_mobile_name">{{ lang('AdminNews.news.general.name') }}</label>
												{{ form.input('news_mobile_name', lang.data.translations, '', '', '') }}
											</div>
											<div class="col-12 col-lg-12">
												<label for="news_mobile_description">{{ lang('AdminNews.news.general.description') }}</label>
												{{ form.textarea('news_mobile_description', lang.data.translations, '', '', '', '10') }}
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
							<div class="row">
								<div class="col-12 col-lg-6 text-lg-right text-center mb-lg-0 mb-2">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE1 }}" class="btn btn-primary" id="custom-form-button1">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i>
											<span>{{ lang('Admin.button.saveAndStayButton') }}</span>
										</span>
									</button>
								</div>
								<div class="col-12 col-lg-6 text-lg-left text-center">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE2 }}" class="btn btn-secondary" id="custom-form-button2">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i>
											<span>{{ lang('Admin.button.saveAndExitButton') }}</span>
										</span>
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
				{{ form_close() }}
			</div>
		</div>
	{% endif %}
{% endblock %}
