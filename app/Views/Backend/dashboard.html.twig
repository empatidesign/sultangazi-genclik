{% extends BACKEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}
{% block body %}
<div class="row">
  <div class="col-sm-12">
    <div class="page-title-box">
      <h4 class="page-title">Dashboard</h4>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-lg-3">
    <div class="card card-eco">
      <div class="card-body">
        <h4 class="title-text mt-0">{{ lang('AdminDashboard.boxes.box1.title') }}</h4>
        <div class="d-flex justify-content-between">
          <h3 class="font-weight-bold">{{ total.contact_requests }}</h3>
          <i class="dripicons-user-group card-eco-icon text-secondary align-self-center"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-3">
    <div class="card card-eco">
      <div class="card-body">
        <h4 class="title-text mt-0">{{ lang('AdminDashboard.boxes.box2.title') }}</h4>
        <div class="d-flex justify-content-between">
          <h3 class="font-weight-bold">{{ total.president_contact_requests }}</h3>
          <i class="dripicons-blog card-eco-icon text-warning align-self-center"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <h4 class="header-title mt-0 mb-3">{{ lang('AdminDashboard.contactRequests.title') }}</h4>
        {% if list.contact_requests != null %}
          <div class="table-responsive">
            <table class="table mb-0">
              <thead class="thead-light">
                <tr>
                  <th class="border-top-0">{{ lang('AdminForms.contactRequests.general.name') }}</th>
                  <th class="border-top-0">{{ lang('AdminForms.contactRequests.general.surname') }}</th>
                  <th class="border-top-0">{{ lang('AdminForms.contactRequests.general.telephone') }}</th>
                  <th class="border-top-0">{{ lang('AdminForms.contactRequests.general.createdDate') }}</th>
                </tr>
              </thead>
              <tbody>
                {% for row in list.contact_requests %}
                  <tr>
                    <td>{{ row.contact_form_name }}</td>
                    <td>{{ row.contact_form_surname }}</td>
                    <td>{{ row.contact_form_telephone }}</td>
                    <td>{{ row.contact_form_created_date }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="alert alert-danger mb-0">{{ lang('Admin.error.noRecord') }}</div>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <h4 class="header-title mt-0 mb-3">{{ lang('AdminForms.presidentContactRequests.title') }}</h4>
        {% if list.president_contact_requests != null %}
          <div class="table-responsive">
            <table class="table mb-0">
              <thead class="thead-light">
                <tr>
                  <th class="border-top-0">{{ lang('AdminForms.presidentContactRequests.general.name') }}</th>
                  <th class="border-top-0">{{ lang('AdminForms.presidentContactRequests.general.surname') }}</th>
                  <th class="border-top-0">{{ lang('AdminForms.presidentContactRequests.general.telephone') }}</th>
                  <th class="border-top-0">{{ lang('AdminForms.presidentContactRequests.general.createdDate') }}</th>
                </tr>
              </thead>
              <tbody>
                {% for row in list.president_contact_requests %}
                  <tr>
                    <td>{{ row.president_contact_request_name }}</td>
                    <td>{{ row.president_contact_request_surname }}</td>
                    <td>{{ row.president_contact_request_telephone }}</td>
                    <td>{{ row.president_contact_request_created_date }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="alert alert-danger mb-0">{{ lang('Admin.error.noRecord') }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
