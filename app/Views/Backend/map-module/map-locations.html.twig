{% extends BACKEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import BACKEND_TEMPLATE_PATH~'/layouts/form-elements.html.twig' as form %}

{% block body %}
<div class="row">
  <div class="col-sm-12">
    <div class="page-title-box">
      <div class="float-right">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL) }}">{{ lang('Admin.homePage') }}</a></li>
    				<li class="breadcrumb-item"><a href="javascript:void(0)">{{ lang('AdminMapModule.mapModuleTitle') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL~'/'~page_url) }}">{{ lang('AdminMapModule.mapLocations.title') }}</a></li>
            {% if page_name == 'add' %}
              <li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.process.addNewRecord') }}</li>
            {% endif %}

            {% if page_name == 'edit' %}
              <li class="breadcrumb-item active" aria-current="page">{{ lang('Admin.process.editRecord') }}</li>
            {% endif %}
          </ol>
      </div>
      <h4 class="page-title">{{ lang('AdminMapModule.mapLocations.title') }}</h4>
    </div>
  </div>
</div>

{% if FLASH_DATA_MESSAGE_SUCCESS %}
  <div class="row">
    <div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
      <div class="alert alert-secondary mb-4 alert-dismissible fade show" role="alert">
      	<button type="button" class="close" data-dismiss="alert" aria-label="Close">
      		<span aria-hidden="true">&times;</span>
      	</button>
      	{{ FLASH_DATA_MESSAGE_SUCCESS }}
      </div>
    </div>
  </div>
{% endif %}

{% if page_name == 'index' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col-12 col-lg-6">
							<div class="main-content-label mb-0 pb-0 border-0">
								<h4 class="header-title">{{ lang('AdminMapModule.mapLocations.title') }}</h4>
							</div>
						</div>
						<div class="col-12 col-lg-6 text-lg-right text-left">
							<a href="{{ base_url(BACKEND_URL~'/'~page_url~'/add') }}" class="btn btn-purple">
								{{ lang('Admin.process.addNewRecord') }}
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col-lg-12">
							<div class="table-responsive">
								<table id="datatable" class="table table-bordered dt-responsive nowrap w-100" data-table-url="{{ datatable_url }}">
									<thead>
										<tr>
											<th>{{ lang('AdminMapModule.mapLocations.general.status') }}</th>
                      <th>{{ lang('AdminMapModule.mapLocations.general.category') }}</th>
                      <th>{{ lang('AdminMapModule.mapLocations.general.types.title') }}</th>
											<th>{{ lang('AdminMapModule.mapLocations.general.name') }}</th>
											<th>{{ lang('AdminMapModule.mapLocations.general.createdDate') }}</th>
											<th>{{ lang('AdminMapModule.mapLocations.general.updatedDate') }}</th>
											<th class="no-sort">{{ lang('Admin.process.title') }}</th>
										</tr>
									</thead>
									<tbody></tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endif %}

{% if page_name == 'add' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/insert', 'class="custom-form"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.process.addNewRecord') }}</h4>
						</div>
            <div class="row">
							<div class="col-12 col-lg-6 mb-3">
								<label for="status">{{ lang('AdminMapModule.mapLocations.general.status') }} <span class="tx-danger">*</span></label>
								<select name="form[status]" id="status" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}">{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}">{{ lang('Admin.passive') }}</option>
								</select>
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="map_category_id">{{ lang('AdminMapModule.mapLocations.general.category') }} <span class="tx-danger">*</span></label>
								<select name="form[map_category_id]" id="map_category_id" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									{% if list.categories != null %}
                    {% for row in list.categories %}
                    <option value="{{ row.map_category_id }}">{{ row.map_category_name }}</option>
                    {% endfor %}
                  {% endif %}
								</select>
							</div>
							<div class="col-12 col-lg-12 mb-3">
								<label for="map_location_name">{{ lang('AdminMapModule.mapLocations.general.name') }} <span class="tx-danger">*</span></label>
								{{ form.input('map_location_name', '', '', '', '') }}
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="map_type_id">{{ lang('AdminMapModule.mapLocations.general.types.title') }} <span class="tx-danger">*</span></label>
								<select name="form[map_type_id]" id="map_type_id" class="form-control select2">
									{% if list.types != null %}
                    {% for key, row in list.types %}
  									<option value="{{ key }}">{{ row }}</option>
                    {% endfor %}
                  {% endif %}
								</select>
							</div>
              <div class="col-12 col-lg-6 map-module-type">
								<label for="map_location_lat_coordinate">{{ lang('AdminMapModule.mapLocations.general.coordinate.lat') }} <span class="tx-danger">*</span></label>
								<input type="text" name="form[map_location_lat_coordinate]" id="map_location_lat_coordinate" class="form-control" autocomplete="off" />
							</div>
              <div class="col-12 col-lg-6">
                <div class="map-projects d-none">
                  <label for="map_project_id">{{ lang('AdminMapModule.mapLocations.general.types.projects') }} <span class="tx-danger">*</span></label>
                  <select name="form[map_project_id]" id="map_project_id" class="form-control select2">
                    <option value="">{{ lang('Admin.choose') }}</option>
                    {% if list.projects != null %}
                      {% for row in list.projects %}
                      <option value="{{ row.project_id }}">{{ row.project_name }}</option>
                      {% endfor %}
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="col-12 col-lg-6 map-module-type">
								<label for="map_location_long_coordinate">{{ lang('AdminMapModule.mapLocations.general.coordinate.long') }} <span class="tx-danger">*</span></label>
								<input type="text" name="form[map_location_long_coordinate]" id="map_location_long_coordinate" class="form-control" autocomplete="off" />
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
	            <button type="submit" class="btn btn-primary waves-effect waves-light" type="submit" id="custom-form-button1">
	  						<span class="d-none loading-spinner">
	  							<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
	  							<span>{{ lang('Admin.loading') }}</span>
	  						</span>
	  						<span class="button-text">
	  							<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.save') }}</span>
	  						</span>
	  					</button>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}

{% if page_name == 'edit' %}
	<div class="row">
		<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
			{{ form_open(BACKEND_URL~'/'~page_url~'/update/'~result.map_location_id, 'class="custom-form"') }}
				<div class="card">
					<div class="card-body">
						<div class="main-content-label">
							<h4 class="header-title">{{ lang('Admin.process.editRecord') }}</h4>
						</div>
            <div class="row">
							<div class="col-12 col-lg-6 mb-3">
								<label for="status">{{ lang('AdminMapModule.mapLocations.general.status') }} <span class="tx-danger">*</span></label>
								<select name="form[status]" id="status" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									<option value="{{ FORM_ACTIVE_NUMBER }}" {{ result.status == FORM_ACTIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.active') }}</option>
									<option value="{{ FORM_PASSIVE_NUMBER }}" {{ result.status == FORM_PASSIVE_NUMBER ? 'selected' : NULL }}>{{ lang('Admin.passive') }}</option>
								</select>
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="map_category_id">{{ lang('AdminMapModule.mapLocations.general.category') }} <span class="tx-danger">*</span></label>
								<select name="form[map_category_id]" id="map_category_id" class="form-control select2">
									<option value="">{{ lang('Admin.choose') }}</option>
									{% if list.categories != null %}
                    {% for row in list.categories %}
                    <option value="{{ row.map_category_id }}" {{ row.map_category_id == result.map_category_id ? 'selected' : NULL }}>{{ row.map_category_name }}</option>
                    {% endfor %}
                  {% endif %}
								</select>
							</div>
							<div class="col-12 col-lg-12 mb-3">
								<label for="map_location_name">{{ lang('AdminMapModule.mapLocations.general.name') }} <span class="tx-danger">*</span></label>
								{{ form.input('map_location_name', lang.data.translations, '', '', '') }}
							</div>
              <div class="col-12 col-lg-6 mb-3">
								<label for="map_type_id">{{ lang('AdminMapModule.mapLocations.general.types.title') }} <span class="tx-danger">*</span></label>
								<select name="form[map_type_id]" id="map_type_id" class="form-control select2">
									{% if list.types != null %}
                    {% for key, row in list.types %}
  									<option value="{{ key }}" {{ key == result.map_type_id ? 'selected' : null }}>{{ row }}</option>
                    {% endfor %}
                  {% endif %}
								</select>
							</div>
              <div class="col-12 col-lg-6 map-module-type">
								<label for="map_location_lat_coordinate">{{ lang('AdminMapModule.mapLocations.general.coordinate.lat') }} <span class="tx-danger {{ result.map_type_id == PARAMETER.TYPES.MAP_LOCATIONS_TYPE_1 ? 'd-inline' : 'd-none' }}">*</span></label>
								<input type="text" name="form[map_location_lat_coordinate]" id="map_location_lat_coordinate" class="form-control" value="{{ result.map_location_lat_coordinate }}" autocomplete="off" />
							</div>
              <div class="col-12 col-lg-6">
                <div class="map-projects {{ result.map_type_id == PARAMETER.TYPES.MAP_LOCATIONS_TYPE_2 ? null : 'd-none' }}">
                  <label for="map_project_id">{{ lang('AdminMapModule.mapLocations.general.types.projects') }} <span class="tx-danger">*</span></label>
                  <select name="form[map_project_id]" id="map_project_id" class="form-control select2">
                    <option value="">{{ lang('Admin.choose') }}</option>
                    {% if list.projects != null %}
                      {% for row in list.projects %}
                      <option value="{{ row.project_id }}" {{ row.project_id == result.map_project_id ? 'selected' : null }}>{{ row.project_name }}</option>
                      {% endfor %}
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="col-12 col-lg-6 map-module-type">
								<label for="map_location_long_coordinate">{{ lang('AdminMapModule.mapLocations.general.coordinate.long') }} <span class="tx-danger {{ result.map_type_id == PARAMETER.TYPES.MAP_LOCATIONS_TYPE_1 ? 'd-inline' : 'd-none' }}">*</span></label>
								<input type="text" name="form[map_location_long_coordinate]" id="map_location_long_coordinate" class="form-control" value="{{ result.map_location_long_coordinate }}" autocomplete="off" />
							</div>
						</div>
					</div>
				</div>

				<div class="card mb-0">
					<div class="card-body">
						<div class="text-center">
							<div class="row">
								<div class="col-12 col-lg-6 text-lg-right text-center mb-lg-0 mb-2">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE1 }}" class="btn btn-primary" id="custom-form-button1">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndStayButton') }}</span>
										</span>
									</button>
								</div>
								<div class="col-12 col-lg-6 text-lg-left text-center">
									<button type="submit" name="redirect" value="{{ FORM_BUTTON_REDIRECT_PAGE2 }}" class="btn btn-secondary" id="custom-form-button2">
										<span class="d-none loading-spinner">
											<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
											<span>{{ lang('Admin.loading') }}</span>
										</span>
										<span class="button-text">
											<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.saveAndExitButton') }}</span>
										</span>
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			{{ form_close() }}
		</div>
	</div>
{% endif %}
{% endblock %}
