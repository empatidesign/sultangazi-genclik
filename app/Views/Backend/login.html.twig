{% extends BACKEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}
{% block body %}
<div class="account-body">
  <div class="row vh-100 ">
    <div class="col-12 align-self-center">
      <div class="auth-page">
        <div class="card auth-card shadow-lg">
          <div class="card-body">
            <div class="px-3">
              <div class="auth-logo-box">
                <div class="logo logo-admin"><img src="{{ base_url(FILE_PATH_ASSETS~'/'~BACKEND_TEMPLATE_PATH~'/'~FILE_PATH_IMAGES~'/logo-dark.svg') }}" height="55" class="auth-logo" alt="" /></div>
              </div>
              <div class="text-center auth-logo-text">
                <h4 class="mt-0 mb-3 mt-5">{{ settings.site_title }}</h4>
                <p class="text-muted mb-0">{{ lang('Admin.loginForm.description') }}</p>
              </div>
              {{ form_open(BACKEND_URL~'/'~PARAMETER.ADMIN_URL_LOGIN_AUTH, 'class="form-horizontal auth-form my-4 custom-form"') }}
                <div class="form-group">
                  <label for="email_address">{{ lang('Admin.form.emailAddress') }} *</label>
                  <div class="input-group mb-3">
                    <span class="auth-form-icon">
                      <i class="dripicons-user"></i>
                    </span>
                    <input type="text" name="email_address" id="email_address" class="form-control" value="{{ cookie.admin_email_address }}" />
                  </div>
                </div>
                <div class="form-group">
                  <label for="password">{{ lang('Admin.form.password') }} *</label>
                  <div class="input-group mb-3">
                    <span class="auth-form-icon">
                      <i class="dripicons-lock"></i>
                    </span>
                    <input type="password" name="password" id="password" class="form-control" autocomplete="off" value="{{ cookie.admin_password }}" />
                  </div>
                </div>
                <div class="form-group row mt-4">
                  <div class="col-sm-6">
                    <div class="custom-control custom-switch switch-success">
                      <input type="checkbox" name="remember_me" id="remember_me" class="custom-control-input" {{ cookie.admin_email_address and cookie.admin_password ? 'checked' : NULL }} />
                      <label for="remember_me" class="custom-control-label text-muted">{{ lang('Admin.loginForm.rememberMe') }}</label>
                    </div>
                  </div>
                </div>
                <div class="form-group mb-0 row">
                  <div class="col-12 mt-2">
                    <button type="submit" class="btn btn-primary btn-round btn-block waves-effect waves-light" id="custom-form-button1">
                      <span class="d-none loading-spinner">
                        <span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
                        <span>{{ lang('Admin.loading') }}</span>
                      </span>
                      <span class="button-text">
                        <i class="mdi mdi-login"></i> <span>{{ lang('Admin.loginForm.button') }}</span>
                      </span>
                    </button>
                  </div>
                </div>
              {{ form_close() }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
