{% extends BACKEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import BACKEND_TEMPLATE_PATH~'/layouts/form-elements.html.twig' as form %}

{% block body %}
<div class="row">
  <div class="col-sm-12">
    <div class="page-title-box">
      <div class="float-right">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ base_url(BACKEND_URL) }}">{{ lang('Admin.homePage') }}</a></li>
    				<li class="breadcrumb-item"><a href="javascript:void(0)">{{ lang('AdminPresident.presidentTitle') }}</a></li>
    				<li class="breadcrumb-item active">{{ lang('AdminPresident.generalInformation.title') }}</li>
          </ol>
      </div>
      <h4 class="page-title">{{ lang('AdminPresident.generalInformation.title') }}</h4>
    </div>
  </div>
</div>

{% if FLASH_DATA_MESSAGE_SUCCESS %}
  <div class="row">
    <div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
      <div class="alert alert-secondary mb-4 alert-dismissible fade show" role="alert">
      	<button type="button" class="close" data-dismiss="alert" aria-label="Close">
      		<span aria-hidden="true">&times;</span>
      	</button>
      	{{ FLASH_DATA_MESSAGE_SUCCESS }}
      </div>
    </div>
  </div>
{% endif %}

<div class="row">
	<div class="col-md-12 col-xl-12 col-xs-12 col-sm-12">
		{{ form_open(BACKEND_URL~'/'~page_url~'/update', 'class="custom-form" enctype="multipart/form-data"') }}
			<div class="card">
				<div class="card-body">
					<div class="main-content-label">
						<h4 class="header-title">{{ lang('AdminPresident.generalInformation.title') }}</h4>
					</div>
					<div class="row">
						<div class="col-lg-6 mb-3">
							<label for="president_name_surname">{{ lang('AdminPresident.generalInformation.general.nameSurname') }} <span class="tx-danger">*</span></label>
							<input type="text" name="president_name_surname" id="president_name_surname" class="form-control" value="{{ result.president_name_surname }}" />
						</div>
            <div class="col-12 col-lg-6 mb-3">
              <label for="president_general_information_sub_title">{{ lang('AdminPresident.generalInformation.general.subTitle') }}</label>
              {{ form.input('president_general_information_sub_title', lang.data.translations, '', '', '') }}
            </div>
            <div class="col-12 col-lg-12 mb-3">
              <label for="president_general_information_link">{{ lang('AdminPresident.generalInformation.general.link') }}</label>
              {{ form.input('president_general_information_link', lang.data.translations, '', '', '') }}
            </div>
            <div class="col-lg-6 mb-3">
							<label for="president_facebook">{{ lang('AdminPresident.generalInformation.general.facebook') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-facebook"></i></span>
								</div>
								<input type="text" name="president_facebook" id="president_facebook" class="form-control" value="{{ result.president_facebook }}" />
							</div>
						</div>
						<div class="col-lg-6 mb-3">
							<label for="president_twitter">{{ lang('AdminPresident.generalInformation.general.twitter') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-twitter"></i></span>
								</div>
								<input type="text" name="president_twitter" id="president_twitter" class="form-control" value="{{ result.president_twitter }}" />
							</div>
						</div>
						<div class="col-lg-6 mb-3">
							<label for="president_instagram">{{ lang('AdminPresident.generalInformation.general.instagram') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-instagram"></i></span>
								</div>
								<input type="text" name="president_instagram" id="president_instagram" class="form-control" value="{{ result.president_instagram }}" />
							</div>
						</div>
						<div class="col-lg-6 mb-3">
							<label for="president_youtube">{{ lang('AdminPresident.generalInformation.general.youtube') }}</label>
							<div class="input-group">
								<div class="input-group-prepend">
									<span class="input-group-text"><i class="fab fa-youtube"></i></span>
								</div>
								<input type="text" name="president_youtube" id="president_youtube" class="form-control" value="{{ result.president_youtube }}" />
							</div>
						</div>
            <div class="col-12 col-lg-6">
              <label for="president_image">{{ lang('AdminPresident.generalInformation.general.image.web') }}</label>
              <input type="file" name="president_image" id="president_image" class="dropify" data-height="200" data-default-file="{{ result.president_image }}" data-url="{{ result.image_remove }}?action=web" />
            </div>
            <div class="col-12 col-lg-6">
              <label for="president_image_mobile">{{ lang('AdminPresident.generalInformation.general.image.mobile') }}</label>
              <input type="file" name="president_image_mobile" id="president_image_mobile" class="dropify" data-height="200" data-default-file="{{ result.president_image_mobile }}" data-url="{{ result.image_remove }}?action=mobile" />
            </div>
					</div>
				</div>
			</div>

			<div class="card mb-0">
				<div class="card-body">
					<div class="text-center">
            <button type="submit" class="btn btn-primary waves-effect waves-light" type="submit" id="custom-form-button1">
  						<span class="d-none loading-spinner">
  							<span class="spinner-border spinner-border-sm mr-1" role="status" aria-hidden="true"></span>
  							<span>{{ lang('Admin.loading') }}</span>
  						</span>
  						<span class="button-text">
  							<i class="mdi mdi-spin mdi-star"></i> <span>{{ lang('Admin.button.save') }}</span>
  						</span>
  					</button>
					</div>
				</div>
			</div>
		{{ form_close() }}
	</div>
</div>
{% endblock %}
