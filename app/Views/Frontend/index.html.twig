{% extends FRONTEND_TEMPLATE_PATH ~ '/layouts/default.html.twig' %}

{% block body %}
	<!-- Slider Start -->
	<section class="bg-primary-900 py-5">
		<div
			class="container mx-auto {{ isMobile ? 'px-0' : 'px-6' }} md:px-0">
			<!-- Main Slider Start -->
			<div class="swiper main-slider">
				<div class="swiper-wrapper">
					{% for row in list.banner.main %}
						<div class="swiper-slide max-h-[600px] {{ isMobile ? null : 'rounded-lg' }} overflow-hidden">
							{% if row.banner_link != null %}
								<a target="{{ row.banner_link_target }}" href="{{ row.banner_link }}" class="block h-full">
									<img src="{{ isMobile ? row.banner_mobile_image.base : row.banner_web_image.base }}" class="object-cover size-full"/>
								</a>
							{% else %}
								<img src="{{ isMobile ? row.banner_mobile_image.base : row.banner_web_image.base }}" class="object-cover size-full"/>
							{% endif %}
						</div>
					{% endfor %}
				</div>

				<!-- Swiper Pagination -->
				<div class="swiper-pagination"></div>
			</div>
			<!-- Main Slider End -->

			<!-- Main Slider Thumbnail Start -->
			<div class="relative mt-4 flex items-center gap-1 sm:gap-2 sm:px-4">
				{% if design.slider_arrow_show == 'true' %}
					<button type="button" class="hidden sm:flex cursor-pointer thumbnail-swiper-prev relative z-10 w-10 h-10 rounded-full bg-white shadow items-center justify-center transition hover:bg-secondary-500 hover:text-white text-lg">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
						</svg>
					</button>
				{% endif %}
				<div class="swiper main-slider-thumbnail flex-1 h-16 sm:h-20" style="{{ isMobile ? 'display: none; height: 0;' : null }}">
					<div class="swiper-wrapper">
						{% for row in list.banner.main %}
							<div class="swiper-slide rounded-lg overflow-hidden">
								<img src="{{ row.banner_web_image.base }}" class="object-cover size-full"/>
							</div>
						{% endfor %}
					</div>
				</div>
				{% if design.slider_arrow_show == 'true' %}
					<button type="button" class="hidden sm:flex cursor-pointer thumbnail-swiper-next relative z-10 w-10 h-10 rounded-full bg-white shadow items-center justify-center transition hover:bg-secondary-500 hover:text-white text-lg">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
						</svg>
					</button>
				{% endif %}
			</div>
			<!-- Main Slider Thumbnail End -->
		</div>
	</section>
	<!-- Slider End -->

	<!-- References Start -->
	{% if list.referances != null %}
		<section class="py-5 xl:pt-10">
			<div class="container mx-auto">
				<div class="flex flex-nowrap overflow-y-hidden overflow-x-auto gap-4 xl:overflow-visible xl:grid xl:grid-cols-6 px-6 xl:px-0">
					{% for row in list.referances %}
						{% if row.referance_link != null %}
							<a target="_blank" href="{{ row.referance_link }}" class="grid place-items-center w-[150px] shrink-0 h-35 xl:w-auto bg-white rounded border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)]"><img src="{{ row.image.base }}" aria-label="{{ row.referance_name }}" title="" alt="{{ row.referance_name }}"/></a>
						{% else %}
							<a href="javascript:void(0);" class="grid place-items-center w-[150px] shrink-0 h-35 xl:w-auto bg-white rounded border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)]"><img src="{{ row.image.base }}" aria-label="{{ row.referance_name }}" title="" alt="{{ row.referance_name }}"/></a>
						{% endif %}
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
	<!-- References End -->

	<!-- Courses Banner Start -->
	<section class="relative hidden xl:block">
		<div class="container mx-auto flex justify-between items-end -mb-[130px]">
			<div class="flex items-end">
				<img src="{{ base_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/karate-girl.png') }}"/>

				<div class="mb-[45px]">
					<h2 class="text-3xl font-bold text-white leading-none">KURSLARIMIZ</h2>
				</div>
			</div>

			<img src="{{ base_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/basketboll-and-swimming.png') }}"/>
		</div>

		<div class="bg-tertiary-500 h-[130px] text-white flex items-center"></div>
	</section>
	<!-- Courses Banner End -->

	{% if list.news.all|length > 0 %}
		<!-- News Start -->
		<section
			class="py-16 bg-primary-900 relative overflow-hidden">
			<!-- Background Layer Start -->
			<div class="absolute top-0 left-0 size-full z-[10] mix-blend-overlay select-none">
				<img class="absolute size-full object-cover opacity-20 blur-lg" src="{{ link_tag('assets/img/general/section-bg.webp') }}"/>
			</div>
			<!-- Background Layer End -->

			<!-- Background Overlay Layer Start -->
			<div class="hidden absolute z-[15] size-[85%] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/10"></div>
			<!-- Background Overlay Layer End -->

			<!-- Content Layer Start -->
			<div class="relative space-y-12.5 z-[30]">
				<div class="container px-6 mx-auto">
					<div class="max-w-lg text-center mx-auto space-y-3">
						<h2 class="text-5xl mb-6 text-white">{{ lang('WebNews.news.title') }}</h2>
						<p class="text-white">{{ lang('WebNews.news.description') }}</p>
					</div>
				</div>

				<div class="container mx-auto">
					<div class="flex flex-nowrap overflow-y-hidden overflow-x-auto gap-4 md:overflow-visible md:grid md:grid-cols-4 px-6">
						{% for row in list.news.all %}
							<div class="group relative w-[280px] max-w-full md:w-full shrink-0 bg-white rounded-md overflow-hidden lg:transition-all lg:hover:scale-105 lg:duration-300">
								<a href="{{ web_url(PARAMETER.WEB_URL_NEWS_DETAIL ~ '/' ~ row.news_slug ~ '/' ~ row.news_id) }}" class="rimage" style="padding-top: 74.0%;">
									<img src="{{ row.image.medium|raw }}" class="rimage__img" />
								</a>
								<a href="{{ web_url(PARAMETER.WEB_URL_NEWS_DETAIL ~ '/' ~ row.news_slug ~ '/' ~ row.news_id) }}" class="size-full">
									<div class="bg-white p-3 md:p-5 text-primary-900 group-hover:text-primary-500">
										<h3 class="line-clamp-2 text-sm leading-normal md:text-base">{{ row.news_name|raw }}</h3>
									</div>
								</a>
							</div>
						{% endfor %}
					</div>
				</div>

				<div class="container px-6 mx-auto grid place-items-center">
					<a href="{{ web_url(PARAMETER.WEB_URL_NEWS) }}" class="inline-block text-lg text-primary-600 bg-white px-16 py-4 rounded-lg shadow transition-all duration-300 hover:bg-secondary-500 hover:text-white shadow-[0_4px_16px_0_rgba(255,255,255,0.5)] backdrop-blur-md">{{ lang('WebNews.news.all') }}</a>
				</div>
			</div>
			<!-- Content Layer End -->
		</section>
		<!-- News End -->
	{% endif %}


	{% if list.events|length > 0 %}
		<!-- Events Start -->
		<section class="py-16 bg-white space-y-12.5">
			<div class="container px-6 mx-auto">
				<div class="max-w-lg text-center mx-auto space-y-3">
					<h2 class="text-5xl mb-6 text-primary-700">
						ETKİNLİK
						<strong>TAKVİMİ</strong>
					</h2>
					<p class="text-gray-600">Sultangazi Eğitim, Gençlik ve Spor faaliyetlerine dair en güncel gelişmeleri, etkinlik duyurularını ve başarı hikayelerini burada</p>
				</div>
			</div>

			<div class="container mx-auto">
				<div class="flex flex-nowrap overflow-x-auto overflow-y-hidden md:overflow-visible md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 px-6">
					{% for row in list.events %}
						<div class="group relative w-[280px] max-w-full md:w-full shrink-0 bg-white border border-gray-200 shadow-[0px_3px_12px_0_rgba(0,0,0,0.05)] hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)] rounded-md overflow-hidden lg:transition-all lg:hover:scale-105 lg:duration-300">
							<a href="{{ sultangazi_url(PARAMETER.WEB_URL_EVENTS~'/'~row.event_slug~'/'~row.event_id) }}" class="rimage" style="padding-top: 100.0%;">
								<img src="{{ row.image.base }}" class="rimage__img" />
							</a>
							<a href="{{ sultangazi_url(PARAMETER.WEB_URL_EVENTS~'/'~row.event_slug~'/'~row.event_id) }}" class="size-full">
								<div class="bg-white p-5">
									<h3 class="text-base font-bold text-black group-hover:text-primary-500 leading-tight h-[2.4em] overflow-hidden line-clamp-2">{{ row.event_name }}</h3>
									<div class="border-t border-gray-200 mb-4"></div>
									<div class="flex flex-col gap-y-3">
										<ul class="space-y-2">
											<li class="flex items-baseline gap-2">
												<div class="grid place-items-center size-5 text-primary-700">
													<i class="fal fa-clock"></i>
												</div>
												<span class="text-sm text-gray-600">TARİH:
													{{ row.event_date.day ~ ' ' ~ row.event_date.month }}</span>
												<span class="text-sm text-gray-600">SAAT:
													{{ row.event_hour }}</span>
											</li>
											<li class="flex items-baseline gap-2">
												<div class="grid place-items-center size-5 text-primary-700">
													<i class="fal fa-map-marker-alt"></i>
												</div>
												<span class="text-sm text-gray-600">{{ row.event_location }}</span>
											</li>
										</ul>
									</div>
								</div>
							</a>
						</div>
					{% endfor %}
				</div>
			</div>

			<div class="container px-6 mx-auto grid place-items-center">
				<a href="https://genclik.sultangazi.bel.tr/tr/etkinlik" class="inline-block text-lg text-primary-600 bg-white px-16 py-4 rounded-lg transition-all duration-300 hover:bg-secondary-500 hover:text-white shadow-[0_4px_16px_0_rgba(0,0,0,0.15)] backdrop-blur-md">
					<span class="font-normal">TÜM</span>
					<strong class="font-bold">ETKİNLİKLER</strong>
				</a>
			</div>
		</section>
		<!-- Events End -->
	{% endif %}

	<!-- Sport Branches Start -->
	<section class="py-16 bg-gray-100 space-y-12.5">
		<div class="container px-6 mx-auto">
			<div class="max-w-lg text-center mx-auto space-y-3">
				<h2 class="text-5xl mb-6 text-primary-700">
					SPOR
					<strong>BRANŞLARIMIZ</strong>
				</h2>
				<p class="text-gray-600">Sultangazi Eğitim, Gençlik ve Spor faaliyetlerine dair en güncel gelişmeleri, etkinlik duyurularını ve başarı hikayelerini burada</p>
			</div>
		</div>

		<div class="container px-6 mx-auto">
			<div class="flex flex-nowrap overflow-x-auto overflow-y-hidden md:grid md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
				{% for sport in list.projects.sport %}
					<div
						href="{{ base_url(PARAMETER.WEB_URL_PROJECTS~'/'~sport.project_slug~'/'~sport.project_id) }}" class="select-none group overflow-hidden relative shrink-0 w-[160px] md:w-full 2xl:aspect-[4/3] p-4 bg-white rounded-lg grid place-items-center shadow-xs transitin-all duration-300 hover:shadow-2xl">
						<!-- Default Layer Start -->
						<div class="flex flex-col justify-center items-center gap-y-3 transition-all group-hover:opacity-0 duration-500">
							<img src="{{ site_url(FILE_PATH_PROJECT ~'/thumb/'~ sport.project_image) }}"/>

							<h3 class="font-bold text-lg text-primary-900">{{ sport.project_name }}</h3>
						</div>
						<!-- Default Layer End -->

						<!-- Hover Layer Start -->
						<div class="absolute top-0 left-0 size-full opacity-0 group-hover:opacity-100 transition-all duration-500">
							<img class="size-full object-cover transitin-all duration-300 scale-0 group-hover:scale-100" alt="{{ sport.project_name }}" src="{{ site_url(FILE_PATH_PROJECT ~'/thumb/'~ sport.project_image2) }}"/>

							<span class="absolute bottom-4 left-0 w-full text-white font-bold text-2xl z-20 text-center scale-0 group-hover:scale-100 transition-all duration-500 delay-100">{{ sport.project_name }}</span>

							<span class="absolute left-0 top-0 z-10 size-full bg-secondary-600 opacity-0 group-hover:opacity-50 transition-all duration-500"></span>
						</div>
						<!-- Hover Layer End -->

						<!-- Link Layer (Optional) Start -->
						<a href="{{ base_url(PARAMETER.WEB_URL_PROJECTS~'/'~sport.project_slug~'/'~sport.project_id) }}" class="absolute top-0 left-0 size-full z-[21]"></a>
						<!-- Link Layer (Optional) End -->
					</div>
				{% endfor %}
			</div>
		</div>
	</section>
	<!-- Sport Branches End -->

	{% if list.statistics|length > 0 %}
		<!-- Numbers Start -->
		<section
			class="py-16 bg-primary-900 relative overflow-hidden">
			<!-- Background Layer Start -->
			<div class="absolute top-0 left-0 size-full z-[10] mix-blend-overlay select-none">
				<img class="absolute size-full object-cover opacity-20 blur-lg" src="{{ base_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/section-bg.webp') }}"/>
			</div>
			<!-- Background Layer End -->

			<!-- Background Overlay Layer Start -->
			<div class="hidden absolute z-[15] size-[85%] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/10"></div>
			<!-- Background Overlay Layer End -->

			<!-- Content Layer Start -->
			<div class="space-y-12.5 relative z-[30]">
				<div class="container px-6 mx-auto">
					<div class="max-w-lg text-center mx-auto space-y-3">
						<h2 class="text-5xl mb-6 text-white">
							SAYILARLA
							<strong>SULTANGAZİ</strong>
						</h2>
						<p class="text-white">Sultangazi Eğitim, Gençlik ve Spor faaliyetlerine dair en güncel gelişmeleri, etkinlik duyurularını ve başarı hikayelerini burada</p>
					</div>
				</div>

				<div id="counter-area" class="container mx-auto">
					<div class="px-6 flex flex-nowrap overflow-x-auto overflow-y-hidden whitespace-nowrap lg:whitespace-normal lg:grid lg:grid-cols-3 xl:grid-cols-4 gap-4">
						{% for item in list.statistics %}
							<div class="group relative flex flex-col shrink-0 items-center min-w-[160px] lg:min-w-auto justify-center text-center gap-y-1 lg:gap-y-4 p-4 aspect-video rounded-lg bg-white shadow-md hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)] transition-shadow duration-300">
								<h3 class="text-xl lg:text-4xl font-bold text-tertiary-500 transition-all duration-300 group-hover:text-secondary-500">{{ item.statistic_name }}</h3>
								<h4 class="text-4xl lg:text-6xl font-bold text-primary-900 transition-all duration-300 group-hover:text-secondary-500">
									<span data-counter="{{ item.statistic_number }}">{{ item.statistic_number }}</span>
								</h4>
							</div>
						{% endfor %}
					</div>
				</div>
			</div>
			<!-- Content Layer End -->
		</section>
		<!-- Numbers End -->
	{% endif %}

	<!-- Service Facilities Start -->
	<section class="py-16 bg-white space-y-12.5">
		<div class="container px-6 mx-auto">
			<div class="max-w-lg text-center mx-auto space-y-3">
				<h2 class="text-5xl mb-6 text-primary-700">
					HİZMET
					<strong>TESİSLERİMİZ</strong>
				</h2>
				<p class="text-gray-600">Sultangazi Eğitim, Gençlik ve Spor faaliyetlerine dair en güncel gelişmeleri, etkinlik duyurularını ve başarı hikayelerini burada</p>
			</div>
		</div>

		<div class="container px-6 mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
				<a href="{{ base_url(WEB_URL_PROJECTS~'/'~list.projects.main_project.project_slug~'/'~list.projects.main_project.project_id) }}" class="bg-white group relative rounded-xl flex flex-col overflow-hidden shadow-xs border border-gray-100 transition-all duration-300 hover:scale-105 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)]">
					<div class="grow overflow-hidden">
						<img src="{{ list.projects.main_project.image.base }}" class="size-full object-cover"/>
					</div>

					<div class="px-6 py-4 flex flex-col gap-1">
						<h3 class="text-xl md:text-2xl font-semibold text-primary-500">{{ list.projects.main_project.project_name }}</h3>
						<p class="text-gray-400">{{ main_project.project_name }}</p>
					</div>
				</a>

				<div class="grid grid-cols-2 gap-4">
					{% for item in list.projects.contents %}
						<a href="#" class="bg-white group relative rounded-xl overflow-hidden shadow-xs border border-gray-100 transition-all duration-300 hover:scale-105">
							<div class="overflow-hidden">
								<img src="{{ item.image.base }}" class="size-full object-cover"/>
							</div>

							<div class="p-4 md:px-6 md:py-4 flex flex-col gap-1 md:gap-1.5">
								<h3 class="md:text-xl font-semibold text-primary-500">{{ item.project_name }}</h3>
								<p class="text-xs md:text-sm text-gray-400">{{ item.project_name }}</p>
							</div>
						</a>
					{% endfor %}
				</div>
			</div>
		</div>

		<div class="container px-6 mx-auto grid place-items-center">
			<a href="{{ base_url(WEB_URL_PROJECTS~'?category=hizmet-tesisleri') }}" class="inline-block text-lg text-primary-600 bg-white px-16 py-4 rounded-lg transition-all duration-300 hover:bg-secondary-500 hover:text-white shadow-[0_4px_16px_0_rgba(0,0,0,0.15)] backdrop-blur-md">
				<span class="font-normal">TÜM</span>
				<strong class="font-bold">TESİSLERİMİZ</strong>
			</a>
		</div>
	</section>
	<!-- Service Facilities End -->
{% endblock %}
