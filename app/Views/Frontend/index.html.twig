{% extends FRONTEND_TEMPLATE_PATH ~ '/layouts/default.html.twig' %}

{% block body %}
	<!-- Slider Start -->
	<section class="bg-primary-900 py-5">
		<div
			class="container mx-auto {{ isMobile ? 'px-0' : 'px-6' }} md:px-0">
			<!-- Main Slider Start -->
			<div class="swiper main-slider">
				<div class="swiper-wrapper">
					{% for row in list.banner.main %}
						<div class="swiper-slide max-h-[600px] {{ isMobile ? null : 'rounded-lg' }} overflow-hidden">
							{% if row.banner_link != null %}
								<a target="{{ row.banner_link_target }}" href="{{ row.banner_link }}" class="block h-full">
									<img src="{{ isMobile ? row.banner_mobile_image.base : row.banner_web_image.base }}" class="object-cover size-full"/>
								</a>
							{% else %}
								<img src="{{ isMobile ? row.banner_mobile_image.base : row.banner_web_image.base }}" class="object-cover size-full"/>
							{% endif %}
						</div>
					{% endfor %}
				</div>

				<!-- Swiper Pagination -->
				<div class="swiper-pagination"></div>
			</div>
			<!-- Main Slider End -->

			<!-- Main Slider Thumbnail Start -->
			<div class="relative mt-4 flex items-center gap-1 sm:gap-2 sm:px-4">
				{% if design.slider_arrow_show == 'true' %}
					<button type="button" class="hidden sm:flex cursor-pointer thumbnail-swiper-prev relative z-10 w-10 h-10 rounded-full bg-white shadow items-center justify-center transition hover:bg-secondary-500 hover:text-white text-lg">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
						</svg>
					</button>
				{% endif %}
				<div class="swiper main-slider-thumbnail flex-1 h-16 sm:h-20" style="{{ isMobile ? 'display: none; height: 0;' : null }}">
					<div class="swiper-wrapper">
						{% for row in list.banner.main %}
							<div class="swiper-slide rounded-lg overflow-hidden">
								<img src="{{ row.banner_web_image.base }}" class="object-cover size-full"/>
							</div>
						{% endfor %}
					</div>
				</div>
				{% if design.slider_arrow_show == 'true' %}
					<button type="button" class="hidden sm:flex cursor-pointer thumbnail-swiper-next relative z-10 w-10 h-10 rounded-full bg-white shadow items-center justify-center transition hover:bg-secondary-500 hover:text-white text-lg">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewbox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
						</svg>
					</button>
				{% endif %}
			</div>
			<!-- Main Slider Thumbnail End -->
		</div>
	</section>
	<!-- Slider End -->

	<!-- References Start -->
	{% if list.referances != null %}
		<section class="py-5 xl:pt-10">
			<div class="container mx-auto">
				<div class="flex flex-nowrap overflow-y-hidden overflow-x-auto gap-4 xl:overflow-visible xl:grid xl:grid-cols-6 px-6 xl:px-0">
					{% for row in list.referances %}
						{% if row.referance_link != null %}
							<a target="_blank" href="{{ row.referance_link }}" class="grid place-items-center w-[150px] shrink-0 h-35 xl:w-auto bg-white rounded border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)]"><img src="{{ row.image.base }}" aria-label="{{ row.referance_name }}" title="" alt="{{ row.referance_name }}"/></a>
						{% else %}
							<a href="javascript:void(0);" class="grid place-items-center w-[150px] shrink-0 h-35 xl:w-auto bg-white rounded border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)]"><img src="{{ row.image.base }}" aria-label="{{ row.referance_name }}" title="" alt="{{ row.referance_name }}"/></a>
						{% endif %}
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
	<!-- References End -->

	<!-- Courses Banner Start -->
	<section class="relative hidden xl:block">
		<div class="container mx-auto flex justify-between items-end -mb-[130px]">
			<div class="flex items-end">
				<img src="{{ base_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/karate-girl.png') }}"/>

				<div class="mb-[45px]">
					<h2 class="text-3xl font-bold text-white leading-none">KURSLARIMIZ</h2>
				</div>
			</div>

			<img src="{{ base_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/basketboll-and-swimming.png') }}"/>
		</div>

		<div class="bg-tertiary-500 h-[130px] text-white flex items-center"></div>
	</section>
	<!-- Courses Banner End -->

	{% if list.news.all|length > 0 %}
		<!-- News Start -->
		<section
			class="py-16 bg-primary-900 relative overflow-hidden">
			<!-- Background Layer Start -->
			<div class="absolute top-0 left-0 size-full z-[10] mix-blend-overlay select-none">
				<img class="absolute size-full object-cover opacity-20 blur-lg" src="{{ base_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/section-bg.webp') }}"/>
			</div>
			<!-- Background Layer End -->

			<!-- Background Overlay Layer Start -->
			<div class="hidden absolute z-[15] size-[85%] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/10"></div>
			<!-- Background Overlay Layer End -->

			<!-- Content Layer Start -->
			<div class="relative space-y-12.5 z-[30]">
				<div class="container px-6 mx-auto">
					<div class="max-w-lg text-center mx-auto space-y-3">
						<h2 class="text-5xl mb-6 text-white">{{ lang('WebNews.news.title') }}</h2>
						<p class="text-white">{{ lang('WebNews.news.description') }}</p>
					</div>
				</div>

				<div class="container mx-auto">
					<div class="flex flex-nowrap overflow-y-hidden overflow-x-auto gap-4 md:overflow-visible md:grid md:grid-cols-4 px-6">
						{% for row in list.news.all %}
							<div class="group relative w-[280px] max-w-full md:w-full shrink-0 bg-white rounded-md overflow-hidden lg:transition-all lg:hover:scale-105 lg:duration-300">
								<a href="{{ web_url(PARAMETER.WEB_URL_NEWS_DETAIL ~ '/' ~ row.news_slug ~ '/' ~ row.news_id) }}" class="rimage" style="padding-top: 74.0%;">
									<img src="{{ row.image.medium|raw }}" class="rimage__img" />
								</a>
								<a href="{{ web_url(PARAMETER.WEB_URL_NEWS_DETAIL ~ '/' ~ row.news_slug ~ '/' ~ row.news_id) }}" class="size-full">
									<div class="bg-white p-3 md:p-5 text-primary-900 group-hover:text-primary-500">
										<h3 class="line-clamp-2 text-sm leading-normal md:text-base">{{ row.news_name|raw }}</h3>
									</div>
								</a>
							</div>
						{% endfor %}
					</div>
				</div>

				<div class="container px-6 mx-auto grid place-items-center">
					<a href="{{ web_url(PARAMETER.WEB_URL_NEWS) }}" class="inline-block text-lg text-primary-600 bg-white px-16 py-4 rounded-lg shadow transition-all duration-300 hover:bg-secondary-500 hover:text-white shadow-[0_4px_16px_0_rgba(255,255,255,0.5)] backdrop-blur-md">{{ lang('WebNews.news.all') }}</a>
				</div>
			</div>
			<!-- Content Layer End -->
		</section>
		<!-- News End -->
	{% endif %}


	<!-- Nexora Events Start -->
	{# Etkinlikler Nexora genel katalog servisinden gelir. #}
	{% if list.nexora_events|length > 0 %}
		<section class="py-16 bg-white space-y-12.5">
			<div class="container px-6 mx-auto">
				<div class="max-w-3xl text-center mx-auto space-y-3">
					<h2 class="text-5xl mb-6 text-primary-700">
						{{ lang('WebIndex.nexora_events.title') }}
						<strong>{{ lang('WebIndex.nexora_events.title_bold') }}</strong>
					</h2>
					<p class="text-gray-600">{{ lang('WebIndex.nexora_events.description') }}</p>
				</div>
			</div>

			<div class="container mx-auto">
				<div class="flex flex-nowrap overflow-x-auto overflow-y-hidden md:overflow-visible md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 px-6">
					{% for item in list.nexora_events %}
						{# Site ici detay sayfasi: yeni sekmede acilmaz #}
						<a href="{{ item.url }}"
							class="group relative w-[280px] max-w-full md:w-full shrink-0 bg-white border border-gray-200 shadow-[0px_3px_12px_0_rgba(0,0,0,0.05)] hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)] rounded-md overflow-hidden lg:transition-all lg:hover:-translate-y-1 lg:duration-300">

							<div class="rimage bg-primary-900" style="padding-top: 66%;">
								{% if item.image %}
									<img src="{{ item.image }}" class="rimage__img transition-transform duration-500 group-hover:scale-105" alt="{{ item.name }}" loading="lazy"/>
								{% else %}
									{# Servis bu etkinlik icin gorsel gondermemis: markali yedek gorunum #}
									<span class="rimage__img flex items-center justify-center bg-gradient-to-br from-primary-700 to-primary-900">
										<i class="fa-solid fa-calendar-days text-4xl text-white/30"></i>
									</span>
								{% endif %}

								{% if item.category %}
									<span class="absolute top-3 left-3 z-10 rounded-full bg-secondary-500 px-3 py-1 text-xs font-semibold text-white">{{ item.category }}</span>
								{% endif %}

								{% if item.is_paid == false %}
									<span class="absolute top-3 right-3 z-10 rounded-full bg-emerald-600 px-3 py-1 text-xs font-semibold text-white">{{ lang('WebIndex.nexora_events.free') }}</span>
								{% endif %}
							</div>

							<div class="bg-white p-5">
								<h3 class="text-base font-bold text-black group-hover:text-primary-500 leading-tight h-[2.4em] overflow-hidden line-clamp-2">{{ item.name }}</h3>

								<div class="border-t border-gray-200 my-3"></div>

								<ul class="space-y-2">
									{% if item.date %}
										<li class="flex items-baseline gap-2">
											<div class="grid place-items-center size-5 text-primary-700">
												<i class="fal fa-clock"></i>
											</div>
											<span class="text-sm text-gray-600">
												{{ lang('WebIndex.nexora_events.date') }}: {{ item.date }}
												{% if item.time %}&middot; {{ item.time }}{% endif %}
											</span>
										</li>
									{% endif %}

									{% if item.place %}
										<li class="flex items-baseline gap-2">
											<div class="grid place-items-center size-5 text-primary-700">
												<i class="fal fa-map-marker-alt"></i>
											</div>
											<span class="text-sm text-gray-600">{{ item.place }}</span>
										</li>
									{% endif %}

									{% if item.open and item.capacity %}
										<li class="flex items-baseline gap-2">
											<div class="grid place-items-center size-5 text-primary-700">
												<i class="fal fa-user-group"></i>
											</div>
											<span class="text-sm text-gray-600">{{ lang('WebIndex.nexora_events.available') }}: {{ item.capacity }}</span>
										</li>
									{% endif %}
								</ul>
							</div>
						</a>
					{% endfor %}
				</div>
			</div>

			<div class="container px-6 mx-auto grid place-items-center">
				<a href="{{ base_url(PARAMETER.WEB_URL_EVENTS) }}"
					class="inline-flex items-center gap-x-3 text-lg text-primary-600 bg-white px-16 py-4 rounded-lg transition-all duration-300 hover:bg-secondary-500 hover:text-white shadow-[0_4px_16px_0_rgba(0,0,0,0.15)]">
					<strong class="font-bold">{{ lang('WebIndex.nexora_events.all') }}</strong>
					<i class="fa-solid fa-arrow-right text-sm"></i>
				</a>
			</div>
		</section>
	{% endif %}
	<!-- Nexora Events End -->

	<!-- Education Institutions Start -->
	{% if list.education|length > 0 %}
		<section class="py-16 bg-white space-y-12.5">
			<div class="container px-6 mx-auto">
				<div class="max-w-2xl text-center mx-auto space-y-3">
					<h2 class="text-5xl mb-6 text-primary-700">
						{{ lang('WebIndex.education.title') }}
						<strong>{{ lang('WebIndex.education.title_bold') }}</strong>
					</h2>
					<p class="text-gray-600">{{ lang('WebIndex.education.description') }}</p>
				</div>
			</div>

			<div class="container px-6 mx-auto">
				<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">
					{% for item in list.education %}
						<a href="{{ item.url }}" target="_blank" rel="noopener"
							class="group relative flex flex-col overflow-hidden rounded-xl bg-white border border-gray-100 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.12)]">

							<!-- Renk Şeridi -->
							<span class="block h-1.5 w-full bg-gradient-to-r {{ item.theme }}"></span>

							<!-- Logo Alanı -->
							<div class="relative bg-gray-50 px-6 py-10 grid place-items-center overflow-hidden">
								<span class="absolute inset-0 bg-gradient-to-br {{ item.theme }} opacity-0 transition-opacity duration-500 group-hover:opacity-10"></span>

								<img class="relative h-20 w-auto max-w-[70%] object-contain transition-transform duration-500 group-hover:scale-110"
									src="{{ base_url(item.image) }}" alt="{{ item.name }}" loading="lazy"/>
							</div>

							<!-- İçerik Alanı -->
							<div class="flex flex-1 flex-col p-6 space-y-2">
								<span class="text-xs font-semibold uppercase tracking-wide text-secondary-600">{{ item.subtitle }}</span>

								<h3 class="text-xl font-semibold text-primary-700">{{ item.name }}</h3>

								<p class="flex-1 text-sm leading-relaxed text-gray-500">{{ item.description }}</p>

								<span class="inline-flex items-center gap-x-2 pt-2 text-sm font-medium text-primary-600 transition-colors duration-300 group-hover:text-secondary-600">
									{{ lang('WebIndex.education.visit') }}
									<i class="fa-solid fa-arrow-right transition-transform duration-300 group-hover:translate-x-1"></i>
								</span>
							</div>
						</a>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
	<!-- Education Institutions End -->

		<!-- Sport Branches Start -->
	<section class="py-16 bg-gray-100 space-y-12.5">
		<div class="container px-6 mx-auto">
			<div class="max-w-3xl text-center mx-auto space-y-3">
				<h2 class="text-5xl mb-6 text-primary-700">
					{{ lang('WebIndex.sport.title') }}
					<strong>{{ lang('WebIndex.sport.title_bold') }}</strong>
				</h2>
				<p class="text-gray-600">{{ lang('WebIndex.sport.description') }}</p>
			</div>
		</div>

		<div class="container px-6 mx-auto">
			<div class="flex flex-nowrap overflow-x-auto overflow-y-hidden md:grid md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
				{% for sport in list.projects.sport %}
					<div class="select-none group overflow-hidden relative shrink-0 w-[160px] md:w-full 2xl:aspect-[4/3] p-4 bg-white rounded-lg grid place-items-center shadow-xs transitin-all duration-300 hover:shadow-2xl">
						<!-- Default Layer Start -->
						<div class="flex flex-col justify-center items-center gap-y-3 transition-all group-hover:opacity-0 duration-500">
							<img src="{{ site_url(FILE_PATH_PROJECT ~'/thumb/'~ sport.project_image) }}" alt="{{ sport.project_name }}"/>

							<h3 class="font-bold text-lg text-primary-900">{{ sport.project_name }}</h3>
						</div>
						<!-- Default Layer End -->

						<!-- Hover Layer Start -->
						<div class="absolute top-0 left-0 size-full opacity-0 group-hover:opacity-100 transition-all duration-500">
							<img class="size-full object-cover transitin-all duration-300 scale-0 group-hover:scale-100" alt="{{ sport.project_name }}" src="{{ site_url(FILE_PATH_PROJECT ~'/thumb/'~ sport.project_image2) }}"/>

							<span class="absolute left-0 top-0 z-10 size-full bg-secondary-600 opacity-0 group-hover:opacity-60 transition-all duration-500"></span>

							<div class="absolute inset-0 z-20 flex flex-col items-center justify-center gap-y-2 px-3 text-center scale-0 group-hover:scale-100 transition-all duration-500 delay-100">
								<span class="text-white font-bold text-xl leading-tight">{{ sport.project_name }}</span>

								<span class="inline-flex items-center gap-x-1.5 text-xs font-medium text-white/90">
									{{ lang('WebIndex.sport.detail') }}
									<i class="fa-solid fa-arrow-up-right-from-square"></i>
								</span>
							</div>
						</div>
						<!-- Hover Layer End -->

						<!-- Detay bağlantısı: Spor Akademisi -->
						<a href="{{ sport.academy_url }}" target="_blank" rel="noopener"
							class="absolute top-0 left-0 size-full z-[21]"
							aria-label="{{ sport.project_name }} - {{ lang('WebIndex.sport.detail') }}"></a>
					</div>
				{% endfor %}
			</div>
		</div>

		<div class="container px-6 mx-auto grid place-items-center">
			<a href="{{ SPORT_ACADEMY_URL ~ '/' ~ SPORT_ACADEMY_PATH_BRANCHES }}" target="_blank" rel="noopener"
				class="inline-flex items-center gap-x-3 text-lg text-primary-600 bg-white px-16 py-4 rounded-lg transition-all duration-300 hover:bg-secondary-500 hover:text-white shadow-[0_4px_16px_0_rgba(0,0,0,0.15)]">
				<strong class="font-bold">{{ lang('WebIndex.sport.all') }}</strong>
				<i class="fa-solid fa-arrow-up-right-from-square text-sm"></i>
			</a>
		</div>
	</section>
	<!-- Sport Branches End -->

	{% if list.statistics|length > 0 %}
		<!-- Numbers Start -->
		<section
			class="py-16 bg-primary-900 relative overflow-hidden">
			<!-- Background Layer Start -->
			<div class="absolute top-0 left-0 size-full z-[10] mix-blend-overlay select-none">
				<img class="absolute size-full object-cover opacity-20 blur-lg" src="{{ base_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/section-bg.webp') }}"/>
			</div>
			<!-- Background Layer End -->

			<!-- Background Overlay Layer Start -->
			<div class="hidden absolute z-[15] size-[85%] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/10"></div>
			<!-- Background Overlay Layer End -->

			<!-- Content Layer Start -->
			<div class="space-y-12.5 relative z-[30]">
				<div class="container px-6 mx-auto">
					<div class="max-w-lg text-center mx-auto space-y-3">
						<h2 class="text-5xl mb-6 text-white">
							SAYILARLA
							<strong>SULTANGAZİ</strong>
						</h2>
						<p class="text-white">Sultangazi Eğitim, Gençlik ve Spor faaliyetlerine dair en güncel gelişmeleri, etkinlik duyurularını ve başarı hikayelerini burada</p>
					</div>
				</div>

				<div id="counter-area" class="container mx-auto">
					<div class="px-6 flex flex-nowrap overflow-x-auto overflow-y-hidden whitespace-nowrap lg:whitespace-normal lg:grid lg:grid-cols-3 xl:grid-cols-4 gap-4">
						{% for item in list.statistics %}
							<div class="group relative flex flex-col shrink-0 items-center min-w-[160px] lg:min-w-auto justify-center text-center gap-y-1 lg:gap-y-4 p-4 aspect-video rounded-lg bg-white shadow-md hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)] transition-shadow duration-300">
								<h3 class="text-xl lg:text-4xl font-bold text-tertiary-500 transition-all duration-300 group-hover:text-secondary-500">{{ item.statistic_name }}</h3>
								<h4 class="text-4xl lg:text-6xl font-bold text-primary-900 transition-all duration-300 group-hover:text-secondary-500">
									<span data-counter="{{ item.statistic_number }}">{{ item.statistic_number }}</span>
								</h4>
							</div>
						{% endfor %}
					</div>
				</div>
			</div>
			<!-- Content Layer End -->
		</section>
		<!-- Numbers End -->
	{% endif %}

	<!-- Service Facilities Start -->
	{# Tesis bilgileri Nexora genel katalog servisinden gelir. #}
	{% if list.facilities|length > 0 %}
		<section class="py-16 bg-white space-y-12.5">
			<div class="container px-6 mx-auto">
				<div class="max-w-3xl text-center mx-auto space-y-3">
					<h2 class="text-5xl mb-6 text-primary-700">
						{{ lang('WebIndex.facilities.title') }}
						<strong>{{ lang('WebIndex.facilities.title_bold') }}</strong>
					</h2>
					<p class="text-gray-600">{{ lang('WebIndex.facilities.description') }}</p>
				</div>
			</div>

			<div class="container px-6 mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{% for item in list.facilities %}
						<a href="{{ item.url }}" target="_blank" rel="noopener"
							class="group bg-white relative rounded-xl flex flex-col overflow-hidden shadow-xs border border-gray-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.12)]">

							<div class="rimage bg-primary-900" style="padding-top: 52%;">
								{% if item.image %}
									<img src="{{ item.image }}" class="rimage__img transition-transform duration-500 group-hover:scale-105" alt="{{ item.name }}" loading="lazy"/>
								{% else %}
									{# Servis bu tesis icin gorsel gondermemis: markali yedek gorunum #}
									<span class="rimage__img flex items-center justify-center bg-gradient-to-br from-primary-700 to-primary-900">
										<i class="fa-solid fa-building text-5xl text-white/25"></i>
									</span>
								{% endif %}

								<span class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></span>

								<div class="absolute bottom-0 left-0 w-full p-5 space-y-1">
									<h3 class="text-xl md:text-2xl font-semibold text-white leading-tight">{{ item.name }}</h3>

									{% if item.location %}
										<span class="inline-flex items-center gap-x-1.5 text-sm text-white/80">
											<i class="fal fa-map-marker-alt"></i>
											{{ item.location }}
										</span>
									{% endif %}
								</div>
							</div>

							<div class="flex flex-1 flex-col gap-3 p-5">
								{% if item.description %}
									<p class="text-sm leading-relaxed text-gray-500 line-clamp-2">{{ item.description }}</p>
								{% endif %}

								{% if item.features|length > 0 %}
									<div class="flex flex-wrap gap-2">
										{% for feature in item.features %}
											<span class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-600">{{ feature }}</span>
										{% endfor %}
									</div>
								{% endif %}

								<div class="mt-auto flex items-center justify-between border-t border-gray-100 pt-3">
									{% if item.capacity %}
										<span class="text-xs text-gray-400">
											{{ lang('WebIndex.facilities.capacity') }}:
											<strong class="font-semibold text-gray-600">{{ item.capacity }}</strong>
										</span>
									{% else %}
										<span></span>
									{% endif %}

									<span class="inline-flex items-center gap-x-1.5 text-sm font-medium text-primary-600 transition-colors duration-300 group-hover:text-secondary-600">
										{{ lang('WebIndex.facilities.detail') }}
										<i class="fa-solid fa-arrow-right transition-transform duration-300 group-hover:translate-x-1"></i>
									</span>
								</div>
							</div>
						</a>
					{% endfor %}
				</div>
			</div>

			<div class="container px-6 mx-auto grid place-items-center">
				<a href="{{ NEXORA_PORTAL_URL ~ '/hizmetler' }}" target="_blank" rel="noopener"
					class="inline-flex items-center gap-x-3 text-lg text-primary-600 bg-white px-16 py-4 rounded-lg transition-all duration-300 hover:bg-secondary-500 hover:text-white shadow-[0_4px_16px_0_rgba(0,0,0,0.15)]">
					<strong class="font-bold">{{ lang('WebIndex.facilities.all') }}</strong>
					<i class="fa-solid fa-arrow-up-right-from-square text-sm"></i>
				</a>
			</div>
		</section>
	{% endif %}
	<!-- Service Facilities End -->
{% endblock %}
