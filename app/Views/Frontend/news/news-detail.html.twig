{% extends FRONTEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import FRONTEND_TEMPLATE_PATH~'/'~folder~'/partials/menu.html.twig' as macro %}

{% block body %}
	<!-- Content Header Start -->
	<section
		class="py-6 2xl:py-12 bg-primary-900 relative overflow-hidden">
		<!-- Background Layer Start -->
		<div class="absolute top-0 left-0 size-full z-[10] mix-blend-overlay select-none">
			<img class="absolute size-full object-cover opacity-20 blur-lg" src="<?= asset('img/demo/general/section-bg.webp') ?>"/>
		</div>
		<!-- Background Layer End -->

		<!-- Background Overlay Layer Start -->
		<div class="hidden absolute z-[15] size-[85%] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/10"></div>
		<!-- Background Overlay Layer End -->

		<div class="relative z-[30]">
			<div class="container px-6 mx-auto">
				<div class="text-2xl md:text-3xl lg:text-3xl font-bold text-white mb-0.5">
					{{ result.news_name|raw }}
				</div>
				<div class="flex flex-nowrap items-center overflow-x-auto overflow-y-hidden gap-1.5">
					<a href="{{ web_url() }}" class="text-sm text-white opacity-75 font-light transition-all hover:opacity-100 duration-300">
						{{ lang('Web.general.homePage') }}
					</a>
					<i class="fal fa-angle-right text-white text-xs opacity-75"></i>
					<a href="{{ web_url(PARAMETER.WEB_URL_NEWS) }}" class="text-sm text-white opacity-75 font-light transition-all hover:opacity-100 duration-300">
						{{ lang('WebNews.news.mainTitle') }}
					</a>
					<i class="fal fa-angle-right text-white text-xs opacity-75"></i>
					<span class="text-sm text-white font-normal">
						{{ result.news_name|raw }}
					</span>
				</div>
			</div>
		</div>
	</section>
	<!-- Content Header End -->

	<!-- Content Start -->
	<section class="py-6">
		<div class="container mx-auto px-6">
			<h1 class="text-tertiary-500 text-2xl md:text-3xl font-bold leading-normal">{{ result.news_name|raw }}</h1>

			<hr
			class="border-t-3 border-gray-100 mt-6 mb-8"/>

			<!-- Swiper Start -->
			<div class="max-w-[1200px] mx-auto mb-10">
				<div class="news-slider swiper">
					<div class="swiper-wrapper">
						{% if list.images != null %}
							{% for row in list.images %}
								<div class="swiper-slide w-full">
									<img src="{{ row.image.format }}" alt="{{ row.news_name|raw }}" class="w-full rounded-xl"/>
								</div>
							{% endfor %}
						{% endif %}
					</div>

					<div class="swiper-pagination"></div>
				</div>
			</div>
			<!-- Swiper End -->

			<article class="html-content mb-10">
				{% if result.news_description != null %}
					{{ result.news_description|raw }}
				{% endif %}

				{% if list.paragraphs != null %}
					{% for row in list.paragraphs %}
						<div class="news-titles mb-3">
							<h5 class="news-title-light">{{ row.news_paragraph_name }}</h5>
						</div>

						{% if result.news_description != null %}
							{% if row.image.normal != null %}
								<div class="mb-3">
									<img src="{{ row.image.format }}" class="img-fluid border" aria-label="{{ row.news_paragraph_name }}" title="{{ row.news_paragraph_name }}" alt="{{ row.news_paragraph_name }}"/>
								</div>
							{% endif %}

							<div class="news-description mb-5">
								{{ row.news_paragraph_description|raw }}
							</div>
						{% endif %}
					{% endfor %}
				{% endif %}
			</article>

			<hr
			class="border-t-3 border-gray-100 mt-6 mb-8"/>

			<!-- Content Start -->
			<section class="py-6">
				<div class="container px-3 md:px-6 mx-auto">
					<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 md:gap-6">
						{% if list.all != null %}
							{% for row in list.all %}
								<div class="group relative bg-white border border-gray-100 shadow-xs transition-all duration-300 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)] rounded-md overflow-hidden">
									<img src="{{ row.image.medium|raw }}"/>
									<div class="bg-white p-3 md:p-5 text-primary-900 group-hover:text-primary-500">
										<h3 class="line-clamp-2 text-sm leading-normal md:text-base">{{ row.news_name|raw }}</h3>
									</div>

									<a href="{{ web_url(PARAMETER.WEB_URL_NEWS_DETAIL~'/'~row.news_slug~'/'~row.news_id) }}" class="absolute top-0 left-0 size-full"></a>
								</div>
							{% endfor %}
						{% else %}
							<div class="alert alert-danger">{{ lang('Web.error.noRecord') }}</div>
						{% endif %}
					</div>
				</div>
			</section>
			<!-- Content End -->
		</div>
	</section>
	<!-- Content End -->

{% endblock %}
