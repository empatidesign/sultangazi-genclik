{% extends FRONTEND_TEMPLATE_PATH ~ '/layouts/default.html.twig' %}

{% import FRONTEND_TEMPLATE_PATH ~ '/' ~ folder ~ '/partials/menu.html.twig' as macro %}

{% block body %}
  <!-- Content Header Start -->
  <section class="py-6 2xl:py-12 bg-primary-900 relative overflow-hidden">
    <!-- Background Layer Start -->
    <div class="absolute top-0 left-0 size-full z-[10] mix-blend-overlay select-none">
      <img class="absolute size-full object-cover opacity-20 blur-lg" src="{{ base_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/section-bg.webp') }}" />
    </div>
    <!-- Background Layer End -->

    <!-- Background Overlay Layer Start -->
    <div class="hidden absolute z-[15] size-[85%] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/10"></div>
    <!-- Background Overlay Layer End -->

    <div class="relative z-[30]">
      <div class="container px-6 mx-auto">
        <div class="text-2xl md:text-3xl lg:text-3xl font-bold text-white mb-0.5">{{ result.project_name|raw }}</div>
        <div class="flex flex-nowrap items-center overflow-x-auto overflow-y-hidden gap-1.5">
          <a href="{{ base_url() }}" class="text-sm text-white opacity-75 font-light transition-all hover:opacity-100 duration-300">{{ lang('Web.general.homePage') }}</a>
          <i class="fal fa-angle-right text-white text-xs opacity-75"></i>
          <span class="text-sm text-white font-normal">{{ result.project_name|raw }}</span>
        </div>
      </div>
    </div>
  </section>
  <!-- Content Header End -->

  <!-- Content Start -->
  <section class="py-6">
    <div class="container mx-auto px-6 flex flex-col lg:flex-row gap-8">
      {{ macro.menu(list.left_menu) }}

      <div class="lg:grow">
        {{ macro.mobileMenu(list.left_menu) }}

		{% if list.images != null %}
			<div class="w-full">
			  <div class="news-slider swiper">
				<div class="swiper-wrapper">
				  {% for row in list.images %}
				  <div class="swiper-slide !w-full">
					<img src="{{ row.image.format }}" class="rounded-xl" title="" alt="" />
				  </div>
				  {% endfor %}
				</div>

				<div class="swiper-pagination"></div>
			  </div>
			</div>
		{% endif %}

		{% if result.project_description != null %}
			<div class="html-content mt-6">
				{{ result.project_description|raw }}
			</div>
		{% endif %}

		{# Spor branşı: bilgiler Spor Akademisi servisinden gelir #}
		{% if academy != null %}
			<div class="mt-6 space-y-6">
				{% if academy.matched and academy.description %}
					<p class="text-gray-600 leading-relaxed">{{ academy.description }}</p>
				{% else %}
					<p class="text-gray-600 leading-relaxed">{{ lang('WebProjects.academy.intro') }}</p>
				{% endif %}

				{% if academy.matched %}
					{# Özet bilgiler #}
					<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
						{% set kutular = [
							{ 'etiket': lang('WebProjects.academy.coach'),    'deger': academy.coach,          'ikon': 'fa-user-tie' },
							{ 'etiket': lang('WebProjects.academy.ageGroup'), 'deger': academy.age_group,      'ikon': 'fa-child-reaching' },
							{ 'etiket': lang('WebProjects.academy.sessions'), 'deger': academy.sessions,       'ikon': 'fa-calendar-week' },
							{ 'etiket': lang('WebProjects.academy.students'), 'deger': academy.total_students, 'ikon': 'fa-users' }
						] %}

						{% for kutu in kutular %}
							{% if kutu.deger %}
								<div class="rounded-xl border border-gray-100 bg-gray-50 p-4 space-y-1">
									<span class="inline-flex items-center gap-x-2 text-xs font-semibold uppercase tracking-wide text-secondary-600">
										<i class="fa-solid {{ kutu.ikon }}"></i>
										{{ kutu.etiket }}
									</span>
									<div class="text-lg font-semibold text-primary-700">{{ kutu.deger }}</div>
								</div>
							{% endif %}
						{% endfor %}
					</div>

					{# Antrenman programı #}
					{% if academy.schedule|length > 0 %}
						<div class="space-y-3">
							<h2 class="text-xl font-semibold text-primary-700">{{ lang('WebProjects.academy.schedule') }}</h2>

							<div class="overflow-x-auto rounded-xl border border-gray-100">
								<table class="w-full text-sm">
									<tbody>
										{% for satir in academy.schedule %}
											<tr class="border-b border-gray-100 last:border-0">
												<td class="px-4 py-3 font-medium text-gray-700">{{ satir.day }}</td>
												<td class="px-4 py-3 text-gray-600">{{ satir.time }}</td>
												<td class="px-4 py-3 text-gray-500">{{ satir.level }}</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						</div>
					{% endif %}

					{# Kazanımlar ve gerekli belgeler #}
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						{% for blok in [
							{ 'baslik': lang('WebProjects.academy.gains'),        'liste': academy.gains,        'ikon': 'fa-circle-check',   'renk': 'text-emerald-600' },
							{ 'baslik': lang('WebProjects.academy.requirements'), 'liste': academy.requirements, 'ikon': 'fa-file-lines',     'renk': 'text-primary-600' }
						] %}
							{% if blok.liste|length > 0 %}
								<div class="space-y-3">
									<h2 class="text-xl font-semibold text-primary-700">{{ blok.baslik }}</h2>

									<ul class="space-y-2">
										{% for madde in blok.liste %}
											<li class="flex items-start gap-x-2 text-sm text-gray-600">
												<i class="fa-solid {{ blok.ikon }} {{ blok.renk }} mt-1"></i>
												<span>{{ madde }}</span>
											</li>
										{% endfor %}
									</ul>
								</div>
							{% endif %}
						{% endfor %}
					</div>
				{% endif %}

				{# Akademiye yönlendirme #}
				<a href="{{ academy.url }}" target="_blank" rel="noopener"
					class="group flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-xl bg-primary-900 p-6 transition-all duration-300 hover:bg-primary-800">
					<div class="space-y-1">
						<div class="text-lg font-semibold text-white">{{ lang('WebProjects.academy.ctaTitle') }}</div>
						<p class="text-sm text-white/70">{{ lang('WebProjects.academy.ctaText') }}</p>
					</div>

					<span class="inline-flex shrink-0 items-center gap-x-2 rounded-lg bg-secondary-500 px-6 py-3 text-sm font-semibold text-white transition-transform duration-300 group-hover:translate-x-1">
						{{ lang('WebProjects.academy.ctaButton') }}
						<i class="fa-solid fa-arrow-up-right-from-square"></i>
					</span>
				</a>
			</div>
		{% endif %}
      </div>
    </div>
  </section>
  <!-- Content End -->
{% endblock %}
