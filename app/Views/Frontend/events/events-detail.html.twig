{% extends FRONTEND_TEMPLATE_PATH ~ '/layouts/default.html.twig' %}

{% block body %}
	{# Detay sayfasi yerel nexora_events tablosundan beslenir; gecmis etkinlik 404 doner. #}

	<!-- Content Header Start -->
	<section class="py-6 2xl:py-12 bg-primary-900 relative overflow-hidden">
		<div class="absolute top-0 left-0 size-full z-[10] mix-blend-overlay select-none">
			<img class="absolute size-full object-cover opacity-20 blur-lg" src="{{ webp_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/section-bg.webp') }}" alt=""/>
		</div>

		<div class="relative z-[30]">
			<div class="container px-6 mx-auto">
				<div class="text-2xl md:text-3xl lg:text-3xl font-bold text-white mb-0.5">{{ result.name }}</div>

				<div class="flex flex-nowrap items-center overflow-x-auto overflow-y-hidden gap-1.5">
					<a href="{{ base_url() }}" class="text-sm text-white opacity-75 font-light transition-all hover:opacity-100 duration-300">{{ lang('Web.general.homePage') }}</a>
					<i class="fal fa-angle-right text-white text-xs opacity-75"></i>
					<a href="{{ base_url(PARAMETER.WEB_URL_EVENTS) }}" class="text-sm text-white opacity-75 font-light transition-all hover:opacity-100 duration-300">{{ lang('WebEvents.title') }}</a>
					<i class="fal fa-angle-right text-white text-xs opacity-75"></i>
					<span class="text-sm text-white font-normal line-clamp-1">{{ result.name }}</span>
				</div>
			</div>
		</div>
	</section>
	<!-- Content Header End -->

	<!-- Content Start -->
	<section class="py-10 lg:py-16">
		<div class="container px-6 mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

				<!-- Sol: Gorsel ve aciklama -->
				<div class="lg:col-span-2 space-y-6">
					<div class="rimage bg-primary-900 rounded-xl overflow-hidden" style="padding-top: 52%;">
						{% if result.image %}
							<img src="{{ result.image }}" class="rimage__img" alt="{{ result.name }}"/>
						{% else %}
							<span class="rimage__img flex items-center justify-center bg-gradient-to-br from-primary-700 to-primary-900">
								<i class="fa-solid fa-calendar-days text-6xl text-white/25"></i>
							</span>
						{% endif %}

						{% if result.category %}
							<span class="absolute top-4 left-4 z-10 rounded-full bg-secondary-500 px-4 py-1.5 text-sm font-semibold text-white">{{ result.category }}</span>
						{% endif %}
					</div>

					<h1 class="text-2xl lg:text-3xl font-bold text-primary-700">{{ result.name }}</h1>

					{% if result.description %}
						<div class="space-y-2">
							<h2 class="text-xl font-semibold text-primary-700">{{ lang('WebEvents.about') }}</h2>
							<div class="html-content text-gray-600 leading-relaxed">{{ result.description|raw }}</div>
						</div>
					{% endif %}
				</div>

				<!-- Sag: Bilgi kutusu ve basvuru -->
				<div class="space-y-4">
					<div class="rounded-xl border border-gray-100 bg-gray-50 p-6 space-y-4">
						{% set satirlar = [
							{ 'ikon': 'fa-calendar',       'etiket': lang('WebEvents.date'),     'deger': result.date.range },
							{ 'ikon': 'fa-clock',          'etiket': lang('WebEvents.time'),     'deger': result.time.start ? (result.time.end ? result.time.start ~ ' - ' ~ result.time.end : result.time.start) : null },
							{ 'ikon': 'fa-map-marker-alt', 'etiket': lang('WebEvents.place'),    'deger': result.place },
							{ 'ikon': 'fa-user-group',     'etiket': lang('WebEvents.ageGroup'), 'deger': result.age.max ? result.age.min ~ ' - ' ~ result.age.max : null },
							{ 'ikon': 'fa-users',          'etiket': lang('WebEvents.capacity'), 'deger': result.capacity }
						] %}

						{% for satir in satirlar %}
							{% if satir.deger %}
								<div class="flex items-start gap-3">
									<div class="grid place-items-center size-8 shrink-0 rounded-lg bg-white text-primary-700">
										<i class="fal {{ satir.ikon }}"></i>
									</div>
									<div>
										<div class="text-xs uppercase tracking-wide text-gray-400">{{ satir.etiket }}</div>
										<div class="font-medium text-primary-800">{{ satir.deger }}</div>
									</div>
								</div>
							{% endif %}
						{% endfor %}

						<div class="flex flex-wrap gap-2 border-t border-gray-200 pt-4">
							<span class="rounded-full px-3 py-1 text-xs font-semibold {{ result.is_paid ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700' }}">
								{{ result.is_paid ? (result.price_info ?: lang('WebEvents.paid')) : lang('WebEvents.free') }}
							</span>

							{% if result.gender and result.gender != 'mixed' %}
								<span class="rounded-full bg-gray-200 px-3 py-1 text-xs font-semibold text-gray-700">{{ lang('WebEvents.gender.' ~ result.gender) }}</span>
							{% endif %}

							{% if result.resident_only %}
								<span class="rounded-full bg-gray-200 px-3 py-1 text-xs font-semibold text-gray-700">{{ lang('WebEvents.residentOnly') }}</span>
							{% endif %}
						</div>
					</div>

					<!-- Basvuru -->
					<div class="rounded-xl bg-primary-900 p-6 space-y-3">
						{% if result.open and result.available > 0 %}
							<div class="text-sm text-white/70">{{ lang('WebEvents.available') }}</div>
							<div class="text-3xl font-bold text-white">{{ result.available }}</div>

							<a href="{{ result.apply_url }}" target="_blank" rel="noopener"
								class="group flex w-full items-center justify-center gap-x-2 rounded-lg bg-secondary-500 px-6 py-3 font-semibold text-white transition-all duration-300 hover:bg-secondary-600">
								{{ lang('WebEvents.apply') }}
								<i class="fa-solid fa-arrow-up-right-from-square text-sm transition-transform duration-300 group-hover:translate-x-1"></i>
							</a>

							<p class="text-xs text-white/60">{{ lang('WebEvents.applyNote') }}</p>
						{% else %}
							<div class="flex items-center gap-x-2 text-white">
								<i class="fa-solid fa-circle-info"></i>
								<span class="font-semibold">{{ result.open ? lang('WebEvents.full') : lang('WebEvents.closed') }}</span>
							</div>
						{% endif %}
					</div>

					{% if result.latitude and result.longitude %}
						<a href="https://www.google.com/maps/search/{{ result.latitude }},{{ result.longitude }}" target="_blank" rel="noopener"
							class="flex items-center justify-center gap-x-2 rounded-xl border border-gray-100 bg-white p-4 text-sm font-medium text-primary-600 transition-all duration-300 hover:bg-primary-50">
							<i class="fal fa-map-pin"></i>
							{{ lang('WebEvents.goToLocation') }}
						</a>
					{% endif %}
				</div>
			</div>

			<!-- Benzer etkinlikler -->
			{% if list.related|length > 0 %}
				<div class="mt-12 space-y-6">
					<h2 class="text-2xl font-semibold text-primary-700">{{ lang('WebEvents.related') }}</h2>

					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
						{% for row in list.related %}
							<a href="{{ row.url }}"
								class="group flex flex-col overflow-hidden rounded-xl bg-white border border-gray-100 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.12)]">

								<div class="rimage bg-primary-900" style="padding-top: 56%;">
									{% if row.image %}
										<img src="{{ row.image }}" class="rimage__img transition-transform duration-500 group-hover:scale-105" alt="{{ row.name }}" loading="lazy"/>
									{% else %}
										<span class="rimage__img flex items-center justify-center bg-gradient-to-br from-primary-700 to-primary-900">
											<i class="fa-solid fa-calendar-days text-3xl text-white/30"></i>
										</span>
									{% endif %}
								</div>

								<div class="p-4 space-y-1">
									<h3 class="text-sm font-bold text-black leading-tight line-clamp-2 transition-colors duration-300 group-hover:text-primary-500">{{ row.name }}</h3>
									<span class="text-xs text-gray-500">{{ row.date.range }}</span>
								</div>
							</a>
						{% endfor %}
					</div>
				</div>
			{% endif %}

			<div class="mt-10 grid place-items-center">
				<a href="{{ base_url(PARAMETER.WEB_URL_EVENTS) }}"
					class="inline-flex items-center gap-x-2 rounded-lg bg-white px-10 py-3 text-primary-600 shadow-[0_4px_16px_0_rgba(0,0,0,0.15)] transition-all duration-300 hover:bg-secondary-500 hover:text-white">
					<i class="fa-solid fa-arrow-left"></i>
					<strong class="font-bold">{{ lang('WebEvents.all') }}</strong>
				</a>
			</div>
		</div>
	</section>
	<!-- Content End -->
{% endblock %}
