{% extends FRONTEND_TEMPLATE_PATH ~ '/layouts/default.html.twig' %}

{% block body %}
	{# Icerik Nexora'dan cron ile yerel tabloya aktarilir; gecmis etkinlikler listelenmez. #}

	<!-- Content Header Start -->
	<section class="py-6 2xl:py-12 bg-primary-900 relative overflow-hidden">
		<div class="absolute top-0 left-0 size-full z-[10] mix-blend-overlay select-none">
			<img class="absolute size-full object-cover opacity-20 blur-lg" src="{{ base_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/section-bg.webp') }}" alt=""/>
		</div>

		<div class="relative z-[30]">
			<div class="container px-6 mx-auto">
				<div class="text-2xl md:text-3xl lg:text-3xl font-bold text-white mb-0.5">{{ lang('WebEvents.title') }}</div>

				<div class="flex flex-nowrap items-center overflow-x-auto overflow-y-hidden gap-1.5">
					<a href="{{ base_url() }}" class="text-sm text-white opacity-75 font-light transition-all hover:opacity-100 duration-300">{{ lang('Web.general.homePage') }}</a>
					<i class="fal fa-angle-right text-white text-xs opacity-75"></i>
					<span class="text-sm text-white font-normal">{{ lang('WebEvents.title') }}</span>
				</div>
			</div>
		</div>
	</section>
	<!-- Content Header End -->

	<!-- Content Start -->
	<section class="py-10 lg:py-16">
		<div class="container px-6 mx-auto space-y-8">
			{% if list.all|length > 0 %}
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
					{% for row in list.all %}
						<a href="{{ row.url }}"
							class="group relative flex flex-col overflow-hidden rounded-xl bg-white border border-gray-100 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.12)]">

							<div class="rimage bg-primary-900" style="padding-top: 66%;">
								{% if row.image %}
									<img src="{{ row.image }}" class="rimage__img transition-transform duration-500 group-hover:scale-105" alt="{{ row.name }}" loading="lazy"/>
								{% else %}
									<span class="rimage__img flex items-center justify-center bg-gradient-to-br from-primary-700 to-primary-900">
										<i class="fa-solid fa-calendar-days text-4xl text-white/30"></i>
									</span>
								{% endif %}

								{% if row.category %}
									<span class="absolute top-3 left-3 z-10 rounded-full bg-secondary-500 px-3 py-1 text-xs font-semibold text-white">{{ row.category }}</span>
								{% endif %}

								{% if row.is_paid == false %}
									<span class="absolute top-3 right-3 z-10 rounded-full bg-emerald-600 px-3 py-1 text-xs font-semibold text-white">{{ lang('WebEvents.free') }}</span>
								{% endif %}
							</div>

							<div class="flex flex-1 flex-col gap-3 p-5">
								<h2 class="text-base font-bold text-black leading-tight line-clamp-2 transition-colors duration-300 group-hover:text-primary-500">{{ row.name }}</h2>

								<ul class="space-y-2 text-sm text-gray-600">
									<li class="flex items-baseline gap-2">
										<div class="grid place-items-center size-5 text-primary-700"><i class="fal fa-calendar"></i></div>
										<span>{{ row.date.range }}{% if row.time.start %} &middot; {{ row.time.start }}{% endif %}</span>
									</li>

									{% if row.place %}
										<li class="flex items-baseline gap-2">
											<div class="grid place-items-center size-5 text-primary-700"><i class="fal fa-map-marker-alt"></i></div>
											<span class="line-clamp-1">{{ row.place }}</span>
										</li>
									{% endif %}
								</ul>

								<div class="mt-auto flex items-center justify-between border-t border-gray-100 pt-3">
									{% if row.open and row.available > 0 %}
										<span class="text-xs text-gray-400">{{ lang('WebEvents.available') }}: <strong class="font-semibold text-gray-600">{{ row.available }}</strong></span>
									{% elseif row.open == false %}
										<span class="text-xs text-gray-400">{{ lang('WebEvents.closed') }}</span>
									{% else %}
										<span class="text-xs text-gray-400">{{ lang('WebEvents.full') }}</span>
									{% endif %}

									<span class="inline-flex items-center gap-x-1.5 text-sm font-medium text-primary-600 transition-colors duration-300 group-hover:text-secondary-600">
										{{ lang('WebEvents.detail') }}
										<i class="fa-solid fa-arrow-right transition-transform duration-300 group-hover:translate-x-1"></i>
									</span>
								</div>
							</div>
						</a>
					{% endfor %}
				</div>

				{% if pagination.links %}
					<div class="flex justify-center">
						{{ pagination.links|raw }}
					</div>
				{% endif %}
			{% else %}
				<div class="rounded-xl border border-gray-100 bg-gray-50 p-10 text-center">
					<i class="fa-solid fa-calendar-days text-4xl text-gray-300"></i>
					<p class="mt-3 text-gray-500">{{ lang('WebEvents.noRecord') }}</p>
				</div>
			{% endif %}
		</div>
	</section>
	<!-- Content End -->
{% endblock %}
