<!-- Footer Start -->
<footer>
	<!-- Photo Gallery Start -->
	<section
		class="bg-primary-900 text-white relative overflow-hidden">
		<!-- Background Layer Start -->
		<div class="absolute top-0 left-0 size-full z-[10] mix-blend-color-burn">
			<img class="absolute size-full object-cover opacity-20 blur-lg" src="{{ webp_url(FILE_PATH_ASSETS~'/img/general/section-bg.webp') }}"/>
		</div>
		<!-- Background Layer End -->

		<!-- Background Overlay Layer Start -->
		<div class="hidden absolute z-[15] size-[85%] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/10 blur-2xl"></div>
		<!-- Background Overlay Layer End -->

		<!-- Content Layer Start -->
		<div class="space-y-20 lg:space-y-25 relative z-[30]">
			<div class="pt-16 container px-6 mx-auto">
				<div class="max-w-lg text-center mx-auto space-y-3">
					<h2 class="text-5xl leading-normal">
						{{ lang('WebGallery.gallery.title') }}
					</h2>
					<p class="font-light">{{ lang('WebGallery.gallery.description') }}</p>
				</div>
			</div>

			<!-- Photo Gallery Grid -->
			<div class="container mx-auto">
				<div class="flex flex-nowrap overflow-y-hidden overflow-x-auto md:overflow-visible md:grid md:grid-cols-6">
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/1.jpg') }}"/>
					</div>
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/2.jpg') }}"/>
					</div>
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/3.jpg') }}"/>
					</div>
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/4.jpg') }}"/>
					</div>
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/5.jpg') }}"/>
					</div>
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/6.jpg') }}"/>
					</div>

					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/7.jpg') }}"/>
					</div>
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/8.jpg') }}"/>
					</div>
					<div class="grid place-items-center border md:col-span-2 md:row-span-2 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/9.jpg') }}"/>
					</div>
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/10.jpg') }}"/>
					</div>
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/11.jpg') }}"/>
					</div>

					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/12.jpg') }}"/>
					</div>
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/13.jpg') }}"/>
					</div>
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/14.jpg') }}"/>
					</div>
					<div class="grid place-items-center border col-span-1 md:aspect-[12/10] w-[150px] h-[150px] md:h-auto md:w-auto shrink-0">
						<img class="size-full object-cover" src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/footer-images/15.jpg') }}"/>
					</div>
				</div>
			</section>
			<!-- Photo Gallery Grid End -->
		</div>

		<!-- Photo Gallery Whitespace -->
		<div class="relative z-[20] hidden lg:block bg-white h-[210px] -mt-[210px]"></div>
		<!-- Photo Gallery Whitespace End -->
	</section>
	<!-- Photo Gallery End -->

	<!-- References Start -->
	{% if list.referances != null %}
		<section class="py-10 xl:py-20">
			<div class="container px-6 xl:px-0 mx-auto">
				<div class="flex flex-nowrap overflow-y-hidden overflow-x-auto gap-4 md:overflow-visible md:grid md:grid-cols-4 xl:grid-cols-8">
					{% for row in list.referances %}
						{% if row.referance_link != null %}
							<a target="_blank" href="{{ row.referance_link }}" class="grid place-items-center w-[150px] shrink-0 h-25 md:w-auto bg-white rounded border border-gray-100 shadow-sm transition-all duration-300 hover:scale-105 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)]">
								<img src="{{ row.image.base }}" alt="{{ row.referance_name }}"/>
							</a>
						{% else %}
							<a href="javascript:void(0);" class="grid place-items-center w-[150px] shrink-0 h-25 md:w-auto bg-white rounded border border-gray-100 shadow-sm transition-all duration-300 hover:scale-105 hover:shadow-[0_4px_40px_0_rgba(0,0,0,0.1)]">
								<img src="{{ row.image.base }}" alt="{{ row.referance_name }}"/>
							</a>
						{% endif %}
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
	<!-- References End -->

	<!-- Mobile App Start -->
	<section class="bg-gray-100 p-10 md:p-6 xl:p-0">
		<div class="container mx-auto flex flex-wrap md:flex-initial md:justify-center xl:justify-between gap-4 md:gap-10 xl:gap-0">
			<div class="flex flex-wrap justify-center text-center gap-x-4 gap-y-6 md:text-start">
				<img src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/general/mobile-app.png') }}" alt="Mobile App" class="size-40">
				<div class="self-end mb-6">
					<h6 class="font-bold text-3xl">
						{{ lang('Web.mobileApplication.description')|raw }}
					</h6>
				</div>
			</div>

			<div class="flex items-center justify-center flex-wrap gap-4">
				<a href="https://apps.apple.com/tr/app/sultangazi-belediyesi/id535063852?l=tr" class="bg-white rounded-lg shadow-xs">
					<img src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/general/app-store.png') }}" alt="App Store" class="h-24">
				</a>
				<a href="https://play.google.com/store/apps/developer?id=Sultangazi+Belediyesi" class="bg-white rounded-lg shadow-xs">
					<img src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/general/play-store.png') }}" alt="Play Store" class="h-24">
				</a>
			</div>
		</div>
	</section>
	<!-- Mobile App End -->

	<!-- Bottom Start -->
	<section class="bg-primary-900 text-white py-10">
		<div
			class="container flex flex-col items-center md:items-stretch xl:flex-row gap-y-10 md:gap-y-14 mx-auto px-6 xl:px-0">
			<!-- Bottom Left Start -->
			<div class="inline-flex flex-col xl:items-start md:self-center xl:w-1/5 shrink-0">
				<a href="{{ web_url() }}" class="inline-block">
					<img src="{{ webp_url(FILE_PATH_MAIN~design.logo) }}" alt="Footer Logo" class="w-36">
				</a>

				{% if social_media != null %}
					<div class="mt-4 pt-4 border-t border-primary-600 flex items-center gap-4 text-lg">
						{% if social_media.facebook != null %}
							<a href="{{ social_media.facebook }}" class="grid place-items-center transition-all hover:text-secondary-500">
								<i class="fa-brands fa-facebook-f"></i>
							</a>
						{% endif %}
						{% if social_media.instagram != null %}
							<a href="{{ social_media.instagram }}" class="grid place-items-center transition-all hover:text-secondary-500">
								<i class="fa-brands fa-instagram"></i>
							</a>
						{% endif %}
						{% if social_media.twitter != null %}
							<a href="{{ social_media.twitter }}" class="grid place-items-center transition-all hover:text-secondary-500">
								<i class="fa-brands fa-x-twitter"></i>
							</a>
						{% endif %}
						{% if social_media.youtube != null %}
							<a href="{{ social_media.youtube }}" class="grid place-items-center transition-all hover:text-secondary-500">
								<i class="fa-brands fa-youtube"></i>
							</a>
						{% endif %}
					</div>
				{% endif %}
			</div>
			<!-- Bottom Left End -->

			{% if footer_menu != null %}
				<!-- Bottom Nav Start -->
				<div class="xl:grow grid grid-cols-2 lg:grid-cols-4 gap-6 xl:flex xl:flex-wrap xl:justify-between">
					{% for row in footer_menu %}
						<div>
							<div class="border-b border-primary-600 mb-4 pb-2">
								<h6 class="font-bold tracking-wider">{{ row.menu_name }}</h6>
							</div>
							<ul class="space-y-3 text-xs md:text-sm">
								{% for value in row.submenu %}
									<li>
										<a href="{{ value.menu_link }}" class="transition-colors hover:text-secondary-500">{{ value.menu_name }}</a>
									</li>
								{% endfor %}
							</ul>
						</div>
					{% endfor %}
				</div>
				<!-- Bottom Nav End -->
			{% endif %}

			<!-- Bottom Right Start -->
			<div class="inline-flex flex-col md:self-center xl:items-end xl:w-1/5 shrink-0">
				<div>
					<div class="flex flex-col gap-y-4">
						<a href="mailto:{{ contact.contact_email }}" class="inline-flex items-center gap-1.5 transition-colors hover:text-secondary-600">
							<i class="fa-regular fa-at"></i>
							<span class="font-medium tracking-wide">{{ contact.contact_email }}</span>
						</a>
						<a href="mailto:{{ settings.company_kep_address }}" class="inline-flex items-center gap-1.5 transition-colors hover:text-secondary-600">
							<i class="fa-regular fa-envelope"></i>
							<span class="font-medium tracking-wide">{{ settings.company_kep_address }}</span>
						</a>
						<a href="tel:{{ contact.contact_fax }}" class="inline-flex items-center gap-1.5 transition-colors hover:text-secondary-600">
							<i class="fa-regular fa-fax"></i>
							<span class="font-medium tracking-wide">{{ contact.contact_fax }}</span>
						</a>
					</div>

					<div class="flex items-center gap-2 mt-4">
						<img src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/general/customer-service.png') }}" alt="Customer Service" class="h-8"/>
					</div>
				</div>
			</div>
			<!-- Bottom Right End -->
		</div>
	</section>
	<!-- Bottom End -->
</footer>
<!-- Footer End -->
