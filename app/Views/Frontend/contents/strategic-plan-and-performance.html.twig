{% extends FRONTEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import FRONTEND_TEMPLATE_PATH~'/'~folder~'/partials/menu.html.twig' as macro %}

{% block body %}
<!-- Content Header Start -->
  <section class="py-6 2xl:py-12 bg-primary-900 relative overflow-hidden">
    <div class="absolute top-0 left-0 size-full z-[10] mix-blend-overlay select-none">
      <img class="absolute size-full object-cover opacity-20 blur-lg" src="{{ webp_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/section-bg.webp') }}" alt=""/>
    </div>

    <div class="relative z-[30]">
      <div class="container px-6 mx-auto">
        <div class="text-2xl md:text-3xl lg:text-3xl font-bold text-white mb-0.5">{{ lang('WebStrategicPlanAndPerformance.title') }}</div>
        <div class="flex flex-nowrap items-center overflow-x-auto overflow-y-hidden gap-1.5">
          <a href="{{ base_url() }}" class="text-sm text-white opacity-75 font-light transition-all hover:opacity-100 duration-300">{{ lang('Web.general.homePage') }}</a>
          <i class="fal fa-angle-right text-white text-xs opacity-75"></i>
          <span class="text-sm text-white font-normal">{{ lang('WebStrategicPlanAndPerformance.title') }}</span>
        </div>
      </div>
    </div>
  </section>
  <!-- Content Header End -->

<section>
  <div class="container px-6 mx-auto">
    <div class="pt-3">
      <div class="flex flex-col lg:flex-row gap-8"><div class="w-full lg:w-[260px] shrink-0">
          {{ macro.menu(list.left_menu) }}
        </div>
        <div class="lg:grow min-w-0">
          <div class="pages strategic-plan page-inner-top">
            <h2>{{ lang('WebStrategicPlanAndPerformance.title') }}</h2>

            {% if list.strategic_plans != null %}
              <div class="row">
                {% for row in list.strategic_plans %}
                <div class="col-12 col-md-12 col-lg-12 col-xl-6 mb-3">
                  <div class="strategic-plan-item">
                    <div class="strategic-plan-item-image">
                      <img src="{{ row.image.base }}" aria-label="{{ row.strategic_plan_name }}" title="{{ row.strategic_plan_name }}" alt="{{ row.strategic_plan_name }}" />
                    </div>
                    <div class="strategic-plan-item-column">
                      <div class="strategic-plan-item-name">{{ row.strategic_plan_name }}</div>
                      <div class="strategic-plan-item-number">{{ lang('WebStrategicPlanAndPerformance.number') }}: {{ row.strategic_plan_number }}</div>
                      <a target="_blank" href="{{ row.file.base }}"><i class="fa fa-eye"></i> {{ lang('WebStrategicPlanAndPerformance.view') }}</a>
                    </div>
                  </div>
                </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
