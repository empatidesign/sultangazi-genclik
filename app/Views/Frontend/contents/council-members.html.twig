{% extends FRONTEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import FRONTEND_TEMPLATE_PATH~'/'~folder~'/partials/menu.html.twig' as macro %}

{% block body %}
<!-- Content Header Start -->
  <section class="py-6 2xl:py-12 bg-primary-900 relative overflow-hidden">
    <div class="absolute top-0 left-0 size-full z-[10] mix-blend-overlay select-none">
      <img class="absolute size-full object-cover opacity-20 blur-lg" src="{{ webp_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/section-bg.webp') }}" alt=""/>
    </div>

    <div class="relative z-[30]">
      <div class="container px-6 mx-auto">
        <div class="text-2xl md:text-3xl lg:text-3xl font-bold text-white mb-0.5">{{ lang('WebCouncilMembers.title') }}</div>
        <div class="flex flex-nowrap items-center overflow-x-auto overflow-y-hidden gap-1.5">
          <a href="{{ base_url() }}" class="text-sm text-white opacity-75 font-light transition-all hover:opacity-100 duration-300">{{ lang('Web.general.homePage') }}</a>
          <i class="fal fa-angle-right text-white text-xs opacity-75"></i>
          <span class="text-sm text-white font-normal">{{ lang('WebCouncilMembers.title') }}</span>
        </div>
      </div>
    </div>
  </section>
  <!-- Content Header End -->

<section>
  <div class="container px-6 mx-auto">
    <div class="pt-3">
      <div class="flex flex-col lg:flex-row gap-8"><div class="w-full lg:w-[260px] shrink-0">
          {{ macro.menu(list.left_menu) }}
        </div>
        <div class="lg:grow min-w-0">
          {% if list.council_members != null %}
            <div class="vice-president-list">
              <div class="row">
                {% for row in list.council_members %}
                <div class="col-sm-12 col-md-12 col-lg-4">
                  <div class="vice-president-list-item text-center">
                    <div class="vice-president-list-image">
                      <img src="{{ row.council_member_image.base }}" class="img-fluid" aria-label="{{ row.council_member_name }} {{ row.council_member_surname }}" title="{{ row.council_member_name }} {{ row.council_member_surname }}" alt="{{ row.council_member_name }} {{ row.council_member_surname }}" />

                      <div class="vice-president-list-title">
                        <img src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/logo/logo-sultangazi-belediyesi.svg') }}" aria-label="" title="" alt="" />
                        <h5 class="name mb-0">{{ row.council_member_name }} {{ row.council_member_surname }}</h5>
                      </div>
                    </div>

                    {% if row.council_member_sub_title != null %}
                      <div class="sub-title">{{ row.council_member_sub_title }}</div>
                    {% endif %}
                  </div>
                </div>
                {% endfor %}

                <div class="mt-3">
                  {{ pagination.list|raw }}
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
