{% extends FRONTEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import FRONTEND_TEMPLATE_PATH~'/'~folder~'/partials/menu.html.twig' as macro %}

{% block body %}
<section class="page-header">
  <div class="container-fluid">
    <div class="page-header-content">
      <h5 class="page-title">{{ result.contract_name }}</h5>
      <div class="breadcrumbs">
        <a href="{{ web_url() }}" class="breadcrumb-text">{{ lang('Web.general.homePage') }}</a>
        <i class="fa-solid fa-angle-right breadcrumb-icon"></i>
        <span class="breadcrumb-text">{{ result.contract_name }}</span>
      </div>
    </div>
  </div>
</section>

<section class="news-list-page">
  <div class="container-fluid">
    <div class="pt-3">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-3">
          {{ macro.menu(list.left_menu) }}
        </div>
        <div class="col-sm-12 col-md-12 col-lg-9">
          <div class="pages page-inner-top">
            <h2>{{ result.contract_name }}</h2>

            {% if result.contract_description != null %}
              <div class="pages-text">{{ result.contract_description|raw }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
