{% extends FRONTEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import FRONTEND_TEMPLATE_PATH~'/'~folder~'/partials/menu.html.twig' as macro %}

{% block body %}
<section class="page-header">
  <div class="container-fluid">
    <div class="page-header-content">
      <h5 class="page-title">{{ lang('WebActivityReport.title') }}</h5>
      <div class="breadcrumbs">
        <a href="{{ web_url() }}" class="breadcrumb-text">{{ lang('Web.general.homePage') }}</a>
        <i class="fa-solid fa-angle-right breadcrumb-icon"></i>
        <span class="breadcrumb-text">{{ lang('WebActivityReport.title') }}</span>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container-fluid">
    <div class="pt-3">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-3">
          {{ macro.menu(list.left_menu) }}
        </div>
        <div class="col-sm-12 col-md-12 col-lg-9">
          <div class="pages activity-report page-inner-top">
            <h2>{{ lang('WebActivityReport.title') }}</h2>

            {% if list.activity_report != null %}
              <div class="row">
                {% for row in list.activity_report %}
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                  <div class="activity-report-item">
                    <a target="_blank" href="{{ row.file.base }}">
                      {% if design.logo_footer != null %}
                        <div class="activity-report-item-image">
                          <img src="{{ base_url(FILE_PATH_MAIN~design.logo_footer) }}" aria-label="" title="" alt="" />
                        </div>
                      {% endif %}

                      <div class="activity-report-item-name">{{ row.activity_report_name }}</div>
                    </a>
                  </div>
                </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
