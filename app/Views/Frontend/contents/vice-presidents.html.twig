{% extends FRONTEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import FRONTEND_TEMPLATE_PATH~'/'~folder~'/partials/menu.html.twig' as macro %}

{% block body %}
<section class="page-header">
  <div class="container-fluid">
    <div class="page-header-content">
      <h5 class="page-title">{{ lang('WebVicePresidents.title') }}</h5>
      <div class="breadcrumbs">
        <a href="{{ web_url() }}" class="breadcrumb-text">{{ lang('Web.general.homePage') }}</a>
        <i class="fa-solid fa-angle-right breadcrumb-icon"></i>
        <span class="breadcrumb-text">{{ lang('WebVicePresidents.title') }}</span>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container-fluid">
    <div class="pt-3">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-3">
          {{ macro.menu(list.left_menu) }}
        </div>
        <div class="col-sm-12 col-md-12 col-lg-9">
          {% if list.vice_presidents != null %}
            <div class="vice-president-list">
              <div class="row">
                {% for row in list.vice_presidents %}
                <div class="col-sm-12 col-md-12 col-lg-6">
                  <a href="{{ row.link }}">
                    <div class="vice-president-list-item text-center">
                      <div class="vice-president-list-image">
                        <img src="{{ row.vice_president_image.base }}" class="img-fluid" aria-label="{{ row.vice_president_name }} {{ row.vice_president_surname }}" title="{{ row.vice_president_name }} {{ row.vice_president_surname }}" alt="{{ row.vice_president_name }} {{ row.vice_president_surname }}" />
                      </div>
                      <div class="vice-president-list-title">
                        <img src="{{ base_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/logo/logo-sultangazi-belediyesi.svg') }}" aria-label="" title="" alt="" />
                        <h5 class="name mb-0">{{ row.vice_president_name }} {{ row.vice_president_surname }}</h5>
                      </div>
                    </div>
                  </a>
                </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
