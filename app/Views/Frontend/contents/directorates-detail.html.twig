{% extends FRONTEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import FRONTEND_TEMPLATE_PATH~'/'~folder~'/partials/menu.html.twig' as macro %}

{% block body %}
<!-- Content Header Start -->
  <section class="py-6 2xl:py-12 bg-primary-900 relative overflow-hidden">
    <div class="absolute top-0 left-0 size-full z-[10] mix-blend-overlay select-none">
      <img class="absolute size-full object-cover opacity-20 blur-lg" src="{{ webp_url(FILE_PATH_ASSETS ~ '/' ~ FILE_PATH_IMAGES ~ '/general/section-bg.webp') }}" alt=""/>
    </div>

    <div class="relative z-[30]">
      <div class="container px-6 mx-auto">
        <div class="text-2xl md:text-3xl lg:text-3xl font-bold text-white mb-0.5">{{ lang('WebDirectorates.title') }}</div>
        <div class="flex flex-nowrap items-center overflow-x-auto overflow-y-hidden gap-1.5">
          <a href="{{ base_url() }}" class="text-sm text-white opacity-75 font-light transition-all hover:opacity-100 duration-300">{{ lang('Web.general.homePage') }}</a>
          <i class="fal fa-angle-right text-white text-xs opacity-75"></i>
          <span class="text-sm text-white font-normal">{{ lang('WebDirectorates.title') }}</span>
        </div>
      </div>
    </div>
  </section>
  <!-- Content Header End -->

<section>
  <div class="container px-6 mx-auto">
    <div class="pt-3">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-3" > 
          <div class="sidebar">
            <div class="page-filter">
              <div class="filter-card card">
                <div class="card-header" style="display:flex;justify-content:space-between;align-items:center">
                 <div style="display:flex;align-items:center;">
                  <img src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/logo/logo-sultangazi-belediyesi.svg') }}" class="img-fluid card-header-img" title="" alt="" />
                  <h5 class="card-header-title mb-0">{{ lang('WebDirectorates.title') }}</h5>
                    </div>
                     <div class="buttonServiceOpens" onclick="openItemNew('newServiceOpen2','iconId2')">
                      <i id="iconId2" class="fas fa-bars"></i>
                    </div>
                </div>
                {% if list.directorates != null %}
                  <div class="card-body" id="newServiceOpen2">
                    <ul>
                      {% for row in list.directorates %}
                      <li class="filter-item {{ row.directorates_id == result.directorates_id ? 'active' : null }}">
                        <a href="{{ row.link }}" class="filter-link">
                          <div>
                            <span>{{ row.directorates_name }}</span>
                          </div>
                        </a>
                      </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
        <div class="lg:grow min-w-0">
          <div class="presidents vice-president-detail page-inner-top">
            <div class="row">
              <div class="col-sm-12 col-md-12 col-lg-6">
                <div class="vice-president-detail-image">
                  {% if result.person.image.normal != null %}
                    <img src="{{ result.person.image.base }}" class="img-fluid" aria-label="{{ result.directorates_name }}" title="{{ result.directorates_name }}" alt="{{ result.directorates_name }}" />
                  {% else %}
                    <img src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/directorates-person-no-image.jpg') }}" class="img-fluid" aria-label="{{ result.directorates_name }}" title="{{ result.directorates_name }}" alt="{{ result.directorates_name }}" />
                  {% endif %}
                </div>
              </div>
              <div class="col-sm-12 col-md-12 col-lg-6">
                <div class="vice-president-detail-text-box">
                  <div class="vice-president-detail-text-box-header">
                    <h6 class="name">{{ result.directorates_name }}</h6>

                    {% if result.person.sub_title != null %}
                      <div class="title">{{ result.person.sub_title }}</div>
                    {% endif %}
                  </div>

                  {% if result.contact.email_address != null or result.contact.telephone != null or result.contact.fax != null %}
                    <div class="vice-president-detail-text-box-body">
                      {% if result.contact.email_address != null %}
                        <div class="email">
                          <i class="fa-solid fa-at"></i>
                          <span><a href="mailto:{{ result.contact.email_address }}">{{ result.contact.email_address }}</a></span>
                        </div>
                      {% endif %}

                      {% if result.contact.telephone != null %}
                        <div class="phone">
                          <i class="fa-solid fa-headset"></i>
                          <span>{{ result.contact.telephone }}</span>
                        </div>
                      {% endif %}

                      {% if result.contact.fax != null %}
                        <div class="phone">
                          <i class="fa-solid fa-print"></i>
                          <span>{{ result.contact.fax }}</span>
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>

          <div class="department-detail-tab-menu mb-4">
            <nav>
              <div class="nav nav-tabs nav-tabs-department-detail" id="nav-tab" role="tablist">
                <a href="javascript:void(0);" style="border-top-left-radius: 10px;" class="nav-link active" id="documents-tab" data-bs-toggle="tab" data-bs-target="#documents" role="tab" aria-controls="documents" aria-selected="true">
                  <img src="{{ webp_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/logo/logo-sultangazi-belediyesi.svg') }}" class="img-fluid" title="" alt="" />
                  {{ lang('WebDirectorates.tabMenu.tab1') }}
                </a>
                <a href="javascript:void(0);" class="nav-link" id="announcements-tab" data-bs-toggle="tab" data-bs-target="#announcements" role="tab" aria-controls="announcements" aria-selected="false">
                  {{ lang('WebDirectorates.tabMenu.tab2') }}
                </a>
                <a href="javascript:void(0);" class="nav-link" id="news-tab" data-bs-toggle="tab" data-bs-target="#news" role="tab" aria-controls="news" aria-selected="false">
                  {{ lang('WebDirectorates.tabMenu.tab3') }}
                </a>
              </div>
            </nav>
            <div class="tab-content nav-content-department-detail" id="nav-tabContent">
              <div class="tab-pane fade show active" id="documents" role="tabpanel" aria-labelledby="documents-tab">
                {% if list.files != null %}
                  <div class="nav-content-departments">
                    {% for row in list.files %}
                    <div class="nav-content-department-item">
                      <h6 class="mb-0 title">{{ row.category_name }}</h6>

                      {% if row.files != null %}
                        {% for value in row.files %}
                        <a target="_blank" href="{{ value.file }}" class="text-decoration-none nav-content-department-item-description d-flex align-items-center {{ not loop.last ? 'mb-3' : null }}">
                          <i class="fa-solid fa-cloud-arrow-down"></i>
                          <p class="mb-0">{{ value.file_name }}</p>
                        </a>
                        {% endfor %}
                      {% endif %}
                    </div>
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="p-3">{{ lang('Web.error.noRecord') }}</div>
                {% endif %}
              </div>
              <div class="tab-pane fade" id="announcements" role="tabpanel" aria-labelledby="announcements-tab">
                {% if list.announcements != null %}
                  <div class="nav-content-departments">
                    {% for row in list.announcements %}
                      <div class="nav-content-department-item">
                        <a target="_blank" href="{{ web_url(PARAMETER.WEB_URL_ANNOUNCEMENTS) }}">
                          <i class="fa fa-bullhorn"></i> {{ row.announcement_name }}
                        </a>
                      </div>
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="p-3">{{ lang('Web.error.noRecord') }}</div>
                {% endif %}
              </div>
              <div class="tab-pane fade" id="news" role="tabpanel" aria-labelledby="news-tab">
                {% if list.news != null %}
                  <div class="nav-content-departments">
                    {% for row in list.news %}
                      <div class="nav-content-department-item">
                        <a target="_blank" href="{{ web_url(PARAMETER.WEB_URL_NEWS_DETAIL~'/'~row.news_slug~'/'~row.news_id) }}">
                          <i class="fa fa-bullhorn"></i> {{ row.news_name }}
                        </a>
                      </div>
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="p-3">{{ lang('Web.error.noRecord') }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
