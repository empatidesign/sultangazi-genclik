{% extends FRONTEND_TEMPLATE_PATH~'/layouts/default.html.twig' %}

{% import FRONTEND_TEMPLATE_PATH~'/'~folder~'/partials/menu.html.twig' as macro %}

{% block body %}
<section class="page-header">
  <div class="container-fluid">
    <div class="page-header-content">
      <h5 class="page-title">{{ lang('WebDirectorates.title') }}</h5>
      <div class="breadcrumbs">
        <a href="{{ web_url() }}" class="breadcrumb-text">{{ lang('Web.general.homePage') }}</a>
        <i class="fa-solid fa-angle-right breadcrumb-icon"></i>
        <span class="breadcrumb-text">{{ lang('WebDirectorates.title') }}</span>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container-fluid">
    <div class="pt-3">
      <div class="row">
        <div class="col-sm-12 col-md-12 col-lg-3">
          {{ macro.menu(list.left_menu) }}
        </div>
        <div class="col-sm-12 col-md-12 col-lg-9">
          <div class="pages page-inner-top">
            {% if list.directorates != null %}
              <div class="row">
                {% for row in list.directorates %}
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                  <a href="{{ row.link }}" class="directorates">
                    {% if row.icon.normal != null %}
                      <img src="{{ row.icon.base }}" class="img-fluid" aria-label="{{ row.directorates_name }}" title="{{ row.directorates_name }}" alt="{{ row.directorates_name }}" />
                    {% else %}
                      <img src="{{ base_url(FILE_PATH_ASSETS~'/'~FILE_PATH_IMAGES~'/directorates-no-image.jpg') }}" class="img-fluid" aria-label="{{ row.directorates_name }}" title="{{ row.directorates_name }}" alt="{{ row.directorates_name }}" />
                    {% endif %}

                    <h2>{{ row.directorates_name }}</h2>
                  </a>
                </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
